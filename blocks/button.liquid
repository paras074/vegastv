<a
  href="{{ block.settings.link }}"
  class="gold-phone-button gold-phone-button--{{ block.settings.style_class }}"
  {% if block.settings.open_in_new_tab %}
    target="_blank"
    rel="noopener noreferrer"
  {% endif %}
  style="
    --button-width: {% if block.settings.width == 'custom' %}{{ block.settings.custom_width }}%{% else %}fit-content{% endif %};
    --button-width-mobile: {% if block.settings.width_mobile == 'custom' %}{{ block.settings.custom_width_mobile }}%{% else %}fit-content{% endif %};
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.style_class == 'button' %}
    <span class="gold-phone-button__icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8 9.73a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92z"/>
      </svg>
    </span>
  {% endif %}

  <span class="gold-phone-button__label">
    {{ block.settings.label | escape }}
  </span>
</a>

{% stylesheet %}
  .gold-phone-button {
    width: var(--button-width);
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 10px 24px 10px 12px;
    border: 1px solid #d6aa42;
    border-radius: 999px;
    background: linear-gradient(
      135deg,
      #f4d477 0%,
      #c8952e 55%,
      #f0ca64 100%
    );
    color: #111111;
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    box-sizing: border-box;
    box-shadow:
      0 8px 22px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.55);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      filter 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .gold-phone-button:hover {
    /* color: #111111; */
    color: #ffffffff; 
    transform: translateY(-2px);
    filter: brightness(1.05);
    box-shadow:
      0 11px 28px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.65);
  }

  .gold-phone-button:focus-visible {
    outline: 3px solid rgba(214, 170, 66, 0.45);
    outline-offset: 3px;
  }

  .gold-phone-button__icon {
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #fff;
    color: #ac0000;
}
  .gold-phone-button__label {
    white-space: nowrap;
  }

  /* Primary button */
 .gold-phone-button--button {
    background: linear-gradient(135deg, #b10000, #900000 55%, #b10000);
    color: #fff;
    border-color: #b10000;
  }

  /* Secondary button */
  .gold-phone-button--button-secondary {
    min-height: 44px;
    padding: 10px 22px;
    gap: 0;
    background: transparent;
    color: #111111;
    border: 2px solid #d6aa42;
    box-shadow: none;
    font-size: 16px;
  }

  .gold-phone-button--button-secondary:hover {
    color: #111111;
    background: #f8f1df;
    border-color: #c8952e;
    transform: translateY(-1px);
    filter: none;
    box-shadow: none;
  }

  /* Plain link style */
  .gold-phone-button--link {
    min-height: auto;
    padding: 4px 0;
    gap: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #9a701e;
    box-shadow: none;
    font-size: 16px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .gold-phone-button--link:hover {
    color: #6e4e11;
    background: transparent;
    transform: none;
    filter: none;
    box-shadow: none;
  }

  @media screen and (max-width: 749px) {
    .gold-phone-button {
      width: var(--button-width-mobile);
      min-height: 52px;
      padding-right: 20px;
    }

    .gold-phone-button--button-secondary {
      min-height: 44px;
      padding: 10px 20px;
    }

    .gold-phone-button--link {
      min-height: auto;
      padding: 4px 0;
    }
  }
{% endstylesheet %}























{% schema %}
{
  "name": "t:names.button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.button_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "link",
          "label": "t:options.link"
        }
      ],
      "default": "button"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.button",
      "category": "t:categories.basic",
      "settings": {
        "link": "shopify://collections/all"
      }
    }
  ]
}
{% endschema %}
