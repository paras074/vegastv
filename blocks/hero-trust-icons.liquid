{% stylesheet %}
  .hero-trust-icons {
    width: 100%;
    max-width: 510px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 32px;
    row-gap: 18px;
    margin-top: 14px;
    box-sizing: border-box;
  }

  .hero-trust-icons__item {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .hero-trust-icons__icon {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #d5a52c;
  }

  .hero-trust-icons__icon svg {
    width: 32px;
    height: 32px;
    display: block;
  }

  .hero-trust-icons__label {
    color: #111111;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .hero-trust-icons {
      max-width: 100%;
      column-gap: 18px;
      row-gap: 15px;
      margin-top: 12px;
    }

    .hero-trust-icons__item {
      gap: 10px;
    }

    .hero-trust-icons__icon {
      width: 30px;
      height: 30px;
      flex-basis: 30px;
    }

    .hero-trust-icons__icon svg {
      width: 28px;
      height: 28px;
    }

    .hero-trust-icons__label {
      font-size: 12px;
      line-height: 1.25;
    }
  }

  @media screen and (max-width: 390px) {
    .hero-trust-icons {
      grid-template-columns: 1fr;
      row-gap: 13px;
    }

    .hero-trust-icons__label {
      font-size: 13px;
    }
  }
{% endstylesheet %}

