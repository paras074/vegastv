      gap: 0;
    }
      .cp-desc {
      font-size: 11px;}
    
    .cp-option {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .cp-circle {
      width: 56px;
      height: 56px;
      margin-bottom: 10px;
    }
    .cp-sep {
      flex-direction: row;
      padding: 16px 0;
    }
    .cp-line {
      width: 100%;
      height: 1px;
      flex: 1;
    }
    .cp-icon {
      width: 60px;
      height: 60px;
    }
  }

  /* ===== Responsive: Very Small Phones ===== */
  @media (max-width: 360px) {
    .cp-modal {
      padding: 22px 16px 0;
    }
    .cp-title {
      font-size: 19px;
    }
    .cp-icon {
      width: 60px;
      height: 60px;
    }
    .cp-circle {
      width: 50px;
      height: 50px;
    }
    .cp-number {
      font-size: 14px;
    }
    .cp-btn {
      font-size: 13px;
      padding: 10px;
    }
  }

  /* ===== Responsive: Short Screens ===== */
  @media (max-height: 640px) {
    .cp-modal {
      max-height: 92vh;
      padding-top: 20px;
    }
    .cp-icon {
      width: 56px;
      height: 56px;
      margin-bottom: 10px;
    }
    .cp-title {
      font-size: 20px;
      margin-bottom: 8px;
    }
    .cp-subtitle {
      margin-bottom: 16px;
    }
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var overlay = document.getElementById('connect-popup-overlay');
    var closeBtn = document.getElementById('cp-close');
    if (!overlay || !closeBtn) return;

    function openPopup(){
      overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closePopup(){
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    // SIRF tab khule jab .js-connect-popup click ho
    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('.js-connect-popup');
      if (trigger) {
        e.preventDefault();
        e.stopPropagation();
        openPopup();
      }
    });

    closeBtn.addEventListener('click', closePopup);
    
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) closePopup();
    });
    
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closePopup();
    });
  });

  
</script>
<script> function openPopup() { overlay.style.display = 'flex'; </script>