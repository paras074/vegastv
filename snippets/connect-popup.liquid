  }
  .cp-or {
    font-size: 11px;
    font-weight: 700;
    color: #777;
    border: 1px solid #e5e5e5;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
