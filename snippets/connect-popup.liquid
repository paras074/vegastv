{%- assign popup_phone = '(702) 720-1109' -%}
{%- assign popup_phone_display = '(702) 720-1109' -%}
{%- assign popup_business_name = 'Vegas TV Mounting' -%}

<div id="connect-popup-overlay" class="cp-overlay" aria-hidden="true">
  <div class="cp-modal" role="dialog" aria-modal="true" aria-labelledby="cp-title">
    <button type="button" class="cp-close" id="cp-close" aria-label="Close popup">&times;</button>
    
    <div class="cp-icon">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="#e21e1e">
        <path d="M12 3a9 9 0 0 0-9 9v5a3 3 0 0 0 3 3h1v-8H5v-1a7 7 0 0 1 14 0v1h-2v8h1a3 3 0 0 0 3-3v-5a9 9 0 0 0-9-9zm-7 11h2v4H6a1 1 0 0 1-1-1v-3zm14 0h2v3a1 1 0 0 1-1 1h-1v-4zm-3 5h-3v2h3a2 2 0 0 0 2-2v-1h-2v1z"/>
      </svg>
    </div>

    <h2 id="cp-title" class="cp-title">Connect With Us</h2>
    <div class="cp-divider"></div>
    <p class="cp-subtitle">Choose your preferred way to reach <strong>{{ popup_business_name }}</strong>.</p>

    <div class="cp-options">
      <div class="cp-option">
        <div class="cp-circle">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="#e21e1e"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.7 21 3 13.3 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"/></svg>
        </div>
        <h3>Call Us</h3>
        <a href="tel:{{ popup_phone }}" class="cp-number">{{ popup_phone_display }}</a>
        <p class="cp-desc">Speak directly with our team</p>
        <a href="tel:{{ popup_phone }}" class="cp-btn">📞 Call Now</a>
      </div>

      <div class="cp-sep">
        <span class="cp-line"></span>
        <span class="cp-or">OR</span>
        <span class="cp-line"></span>
      </div>

      <div class="cp-option">
        <div class="cp-circle">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="#e21e1e"><path d="M12 2C6.5 2 2 5.9 2 10.5c0 2.3 1.1 4.4 2.9 5.9-.1.9-.6 2.1-1.6 3.3 0 0 1.9-.1 3.9-1.4.8.2 1.7.3 2.6.3 5.5 0 10-3.9 10-8.5S17.5 2 12 2z"/></svg>
        </div>
        <h3>Text Us</h3>
        <a href="sms:{{ popup_phone }}" class="cp-number">{{ popup_phone_display }}</a>
        <p class="cp-desc">Quick responses via text</p>
        <a href="sms:{{ popup_phone }}" class="cp-btn">💬 Text Now</a>
      </div>
    </div>
  </div>
</div>

<style>
  .cp-overlay {
