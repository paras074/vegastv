<div
  class="related-services color-{{ section.settings.color_scheme }}"
  style="
    --padding-top-desktop: {{ section.settings.padding_top }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="related-services__wrapper page-width">
    {% if section.settings.heading != blank %}
      <h2 class="related-services__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="related-services__grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'service' %}
            <div class="related-services__card" >
              <div class="related-services__icon">
                {% case block.settings.icon %}
                  {% when 'home' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg>
                  {% when 'wifi' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13a10 10 0 0 1 14 0"/><path d="M8.5 16.5a5 5 0 0 1 7 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                  {% when 'bolt' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h8l-1 8 10-12h-8l1-8Z"/></svg>
                  {% when 'camera' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 7 16 12l7 5V7Z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
                  {% when 'lightbulb' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.3h6c0-1 .4-1.8 1-2.3A7 7 0 0 0 12 2Z"/></svg>

                  {% when 'Voltage' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3 4 6v5c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6l-8-3Z"></path>
                      <path d="m9 12 2 2 4-4"></path>
                    </svg>

                  {% when 'IST' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="9" r="6"></circle>
                      <path d="m9 14-1 7 4-2 4 2-1-7"></path>
                      <path d="m10 9 1.5 1.5L14 8"></path>
                    </svg>

                  {% when 'CIT' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3 14 5l3-.2.8 2.8 2.2 2-1.2 2.7.4 2.8-2.7 1.2-1.5 2.5-3-.8-3 .8-1.5-2.5-2.7-1.2.4-2.8L3 9.6l2.2-2 .8-2.8L9 5l3-2Z"></path>
                      <path d="m9 12 2 2 4-4"></path>
                    </svg>

                  {% when 'Audiovisual' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="9" y="3" width="6" height="6" rx="1"></rect>
                      <rect x="3" y="15" width="6" height="6" rx="1"></rect>
                      <rect x="15" y="15" width="6" height="6" rx="1"></rect>
                      <path d="M12 9v3"></path>
                      <path d="M6 15v-3h12v3"></path>
                    </svg>

                  {% when 'OSHA' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 14h16"></path>
                      <path d="M5 14a7 7 0 0 1 14 0"></path>
                      <path d="M12 7V4"></path>
                      <path d="M3 18h18"></path>
                    </svg>

                  {% when '$1M' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3 4 6v5c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6l-8-3Z"></path>
                      <path d="M8 12h8"></path>
                      <path d="M12 8v8"></path>
                    </svg>



                {% endcase %}
              </div>
              <div class="related-services__content">
                <h3 class="related-services__card-heading">{{ block.settings.heading }}</h3>
                {% if block.settings.text != blank %}
                  <p class="related-services__text">{{ block.settings.text }}</p>
                {% endif %}
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Related services",
  "class": "section-new",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related Services In Las Vegas"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "home", "label": "Home" },
            { "value": "wifi", "label": "WiFi" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "camera", "label": "Camera" },
            { "value": "lightbulb", "label": "Lightbulb" },
            { "value": "Voltage", "label": "C-2d Low Voltage Licensed" },
            { "value": "IST", "label": "CEDIA IST Certified" },
            { "value": "CIT", "label": "CEDIA CIT Certified" },
            { "value": "Audiovisual", "label": "Audiovisual Network Professional™ Certified" },
            { "value": "OSHA", "label": "OSHA 30 Trained" },
            { "value": "$1M", "label": "$1M General Liability Insurance" }
          ],
          "default": "home"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Home Automation"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Control your whole flat setup automatically."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Related services",
      "blocks": [
        { "type": "service", "settings": { "icon": "home", "heading": "Home Automation", "text": "Control your whole flat setup automatically." } },
        { "type": "service", "settings": { "icon": "wifi", "heading": "WiFi & Network", "text": "Extend signals and high speed routers." } },
        { "type": "service", "settings": { "icon": "bolt", "heading": "Electrical Install", "text": "Custom outlet and smart switches installation." } }
      ]
    }
  ]
}
{% endschema %}