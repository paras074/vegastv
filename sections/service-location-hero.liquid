<div
  class="service-hero-section color-{{ section.settings.color_scheme }}"
  style="
    --pt-desktop: {{ section.settings.padding_top }}px;
    --pb-desktop: {{ section.settings.padding_bottom }}px;
    --pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="service-hero-section__container page-width">
    <div class="service-hero-section__grid">

      <div class="service-hero-section__content">

        {%- if section.settings.eyebrow != blank -%}
         <p class="service-hero-section__eyebrow"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="24" viewBox="0 0 19 24" fill="none">
    <path d="M9.5 15C11.9818 15 14 12.7575 14 10C14 7.2425 11.9818 5 9.5 5C7.01825 5 5 7.2425 5 10C5 12.7575 7.01825 15 9.5 15ZM9.5 7.5C10.7409 7.5 11.75 8.62125 11.75 10C11.75 11.3788 10.7409 12.5 9.5 12.5C8.25912 12.5 7.25 11.3788 7.25 10C7.25 8.62125 8.25912 7.5 9.5 7.5Z" fill="#AC0000"/>
    <path d="M8.81126 23.7775C9.01237 23.9222 9.25312 24 9.5 24C9.74688 24 9.98763 23.9222 10.1887 23.7775C10.5497 23.5195 19.0343 17.3285 18.9999 9.6003C18.9999 4.30693 14.738 0 9.5 0C4.262 0 0.000104544 4.30693 0.000104544 9.5943C-0.0343326 17.3285 8.45026 23.5195 8.81126 23.7775ZM9.5 2.40007C13.4294 2.40007 16.6249 5.62937 16.6249 9.6063C16.6499 14.9321 11.4142 19.7142 9.5 21.2827C7.58696 19.713 2.35014 14.9297 2.37508 9.6003C2.37508 5.62937 5.57061 2.40007 9.5 2.40007Z" fill="#AC0000"/>
    </svg> <span> {{ section.settings.eyebrow }}</span></p>
            {%- endif -%}

        {%- if section.settings.heading != blank or section.settings.heading_highlight != blank -%}
          <h2 class="service-hero-section__heading">
            {%- if section.settings.heading != blank -%}
              <span class="service-hero-section__heading-main">{{ section.settings.heading }}</span>
            {%- endif -%}
            {%- if section.settings.heading_highlight != blank -%}
              <span class="service-hero-section__heading-highlight">{{ section.settings.heading_highlight }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if section.settings.paragraph != blank -%}
          <div class="service-hero-section__paragraph">{{ section.settings.paragraph }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="service-hero-section__trust-list" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'trust_item' -%}
                <li class="service-hero-section__trust-item" {{ block.shopify_attributes }}>
                  <span class="service-hero-section__trust-icon">
                    {%- if block.settings.icon_type == 'svg' and block.settings.svg_code != blank -%}
                      {{ block.settings.svg_code }}
                    {%- elsif block.settings.icon_type == 'image' and block.settings.icon_image != blank -%}
                      {{
                        block.settings.icon_image
                        | image_url: width: 60
                        | image_tag: loading: 'lazy', class: 'service-hero-section__trust-icon-img'
                      }}
                    {%- endif -%}
                  </span>
                  {%- if block.settings.text != blank -%}
                    <span class="service-hero-section__trust-text">{{ block.settings.text }}</span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
          <div class="hero-section__buttons">
            {%- if section.settings.button_1_label != blank -%}
              <a
                {% if section.settings.button_1_link != blank %}
                  href="{{ section.settings.button_1_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="btn-primary">
                <span class="gold-phone-button__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                </span> 
                <span>{{ section.settings.button_1_label }}</span>
              </a>
            {%- endif -%}

            {%- if section.settings.button_2_label != blank -%}
              <a
                {% if section.settings.button_2_link != blank %}
                  href="{{ section.settings.button_2_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="btn-secondary js-connect-popup"
              >
                {{ section.settings.button_2_label }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>

      {%- if section.settings.image != blank -%}
        <div class="service-hero-section__media">
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', class: 'service-hero-section__media-img'
          }}

          {%- if section.settings.badge_number != blank or section.settings.badge_label != blank -%}
            <div class="service-hero-section__badge">
              {%- if section.settings.badge_number != blank -%}
                <span class="service-hero-section__badge-number">{{ section.settings.badge_number }}</span>
              {%- endif -%}
              {%- if section.settings.badge_label != blank -%}
                <span class="service-hero-section__badge-label">{{ section.settings.badge_label }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Service location hero",
  "class": "section-location",
  "settings": [
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Professional, Reliable, Local"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TV Mounting Services in"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading highlight",
      "info": "Shown on its own line in the accent color.",
      "default": "Las Vegas"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "<p>Safe, secure, and seamless TV mounting solutions for homes, businesses, and commercial spaces across Las Vegas and the surrounding valley.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Image badge"
    },
    {
      "type": "text",
      "id": "badge_number",
      "label": "Badge number",
      "default": "15+"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge label",
      "default": "Years Experience"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "svg", "label": "SVG code" }
          ],
          "default": "svg"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },
        {
          "type": "html",
          "id": "svg_code",
          "label": "SVG code",
          "info": "Used only when icon type is set to SVG code."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Licensed & Insured"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service location hero",
      "blocks": [
        { "type": "trust_item" },
        { "type": "trust_item" },
        { "type": "trust_item" },
        { "type": "trust_item" }
      ]
    }
  ]
}
{% endschema %}