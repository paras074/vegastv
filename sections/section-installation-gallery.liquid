{%- liquid
  assign section_id = section.id
-%}

<div
  class="installation-gallery color-{{ section.settings.color_scheme }}"
  style="
    --pt-desktop: {{ section.settings.padding_top }}px;
    --pb-desktop: {{ section.settings.padding_bottom }}px;
    --pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="installation-gallery__container page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="installation-gallery__heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.sub_heading != blank -%}
      <div class="installation-gallery__sub-heading">
        {{ section.settings.sub_heading }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="installation-gallery__carousel-wrap">

        <button type="button" class="installation-gallery__nav installation-gallery__nav--prev" data-gallery-prev="{{ section_id }}" aria-label="Previous">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="16" viewBox="0 0 11 18" fill="none">
            <path d="M7.98387 0.519231L0.532258 7.78846C-0.177419 8.48077 -0.177419 9.51923 0.532258 10.2115L7.98387 17.4808C8.69355 18.1731 9.75806 18.1731 10.4677 17.4808C11.1774 16.7885 11.1774 15.75 10.4677 15.0577L4.25806 9L10.4677 2.94231C10.8226 2.59615 11 2.25 11 1.73077C11 1.21154 10.8226 0.865385 10.4677 0.519231C9.75806 -0.173077 8.69355 -0.173077 7.98387 0.519231Z" fill="currentColor"/>
          </svg>
        </button>

        <ul class="installation-gallery__track" id="gallery-track-{{ section_id }}" role="list">
          {%- for block in section.blocks -%}
            <li class="installation-gallery__slide" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <button
                  type="button"
                  class="installation-gallery__zoom"
                  data-gallery-open
                  data-full="{{ block.settings.image | image_url: width: 1800 }}"
                  data-alt="{{ block.settings.caption | default: section.settings.heading | escape }}"
                  data-caption="{{ block.settings.caption | escape }}"
                  aria-label="Open image in popup"
                >
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 33vw, 80vw',
                      class: 'installation-gallery__image',
                      alt: section.settings.heading
                  }}
                </button>
              {%- else -%}
                <div class="installation-gallery__image installation-gallery__image--placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {%- endif -%}

              {%- if block.settings.caption != blank -%}
                <p class="installation-gallery__caption">{{ block.settings.caption }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        <button type="button" class="installation-gallery__nav installation-gallery__nav--next" data-gallery-next="{{ section_id }}" aria-label="Next">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="16" viewBox="0 0 11 18" fill="none">
            <path d="M3.01613 17.4808L10.4677 10.2115C11.1774 9.51923 11.1774 8.48077 10.4677 7.78846L3.01613 0.519231C2.30645 -0.173077 1.24194 -0.173077 0.532259 0.519231C-0.177419 1.21154 -0.177419 2.25 0.532259 2.94231L6.74194 9L0.532259 15.0577C0.17742 15.4038 0 15.75 0 16.2692C0 16.7885 0.17742 17.1346 0.532259 17.4808C1.24194 18.1731 2.30645 18.1731 3.01613 17.4808Z" fill="currentColor"/>
          </svg>
        </button>

      </div>

      {%- comment -%} Lightbox popup {%- endcomment -%}
      <div
        class="installation-gallery__modal"
        data-modal-for="{{ section_id }}"
        role="dialog"
        aria-modal="true"
        aria-label="Image gallery"
        hidden
      >
        <div class="installation-gallery__modal-backdrop" data-modal-close></div>

        <button type="button" class="installation-gallery__modal-close" data-modal-close aria-label="Close">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 3l14 14M17 3L3 17"/></svg>
        </button>

        <button type="button" class="installation-gallery__modal-nav installation-gallery__modal-nav--prev" data-modal-prev aria-label="Previous image">
          <svg width="14" height="22" viewBox="0 0 11 18" fill="none"><path d="M9 1L1 9l8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <figure class="installation-gallery__modal-figure">
          <img class="installation-gallery__modal-img" src="" alt="">
          <figcaption class="installation-gallery__modal-caption"></figcaption>
        </figure>

        <button type="button" class="installation-gallery__modal-nav installation-gallery__modal-nav--next" data-modal-next aria-label="Next image">
          <svg width="14" height="22" viewBox="0 0 11 18" fill="none"><path d="M2 1l8 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="installation-gallery__modal-counter"></div>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="installation-gallery__cta">
        <a href="{{ section.settings.button_link }}" class="installation-gallery__button">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  /* Thumbnail click button reset */
  .installation-gallery__zoom {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    font: inherit;
    color: inherit;
  }
  .installation-gallery__zoom .installation-gallery__image {
    display: block;
    width: 100%;
  }

  /* Lightbox */
  .installation-gallery__modal {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .installation-gallery__modal[hidden] {
    display: none;
  }
  .installation-gallery__modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
  }
  .installation-gallery__modal-figure {
    position: relative;
    margin: 0;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .installation-gallery__modal-img {
    display: block;
    max-width: 90vw;
    max-height: 80vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    user-select: none;
    -webkit-user-drag: none;
  }
  .installation-gallery__modal-caption {
    color: #fff;
    font-size: 1.4rem;
    text-align: center;
  }
  .installation-gallery__modal-caption:empty {
    display: none;
  }
  .installation-gallery__modal-close,
  .installation-gallery__modal-nav {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .installation-gallery__modal-close:hover,
  .installation-gallery__modal-nav:hover {
    background: rgba(255, 255, 255, 0.3);
  }
  .installation-gallery__modal-close {
    top: 16px;
    right: 16px;
  }
  .installation-gallery__modal-nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .installation-gallery__modal-nav--prev {
    left: 16px;
  }
  .installation-gallery__modal-nav--next {
    right: 16px;
  }
  .installation-gallery__modal-counter {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: #fff;
    font-size: 1.4rem;
    opacity: 0.85;
  }
  body.installation-gallery-lock {
    overflow: hidden;
  }
  @media (max-width: 749px) {
    .installation-gallery__modal-nav--prev { left: 8px; }
    .installation-gallery__modal-nav--next { right: 8px; }
    .installation-gallery__modal-close { top: 8px; right: 8px; }
  }
</style>

<script>
  (function () {
    var sectionId = '{{ section_id }}';
    var track = document.getElementById('gallery-track-' + sectionId);
    if (!track) return;

    var prevBtn = document.querySelector('[data-gallery-prev="' + sectionId + '"]');
    var nextBtn = document.querySelector('[data-gallery-next="' + sectionId + '"]');

    function scrollByAmount(direction) {
      var slide = track.querySelector('.installation-gallery__slide');
      if (!slide) return;
      var amount = slide.getBoundingClientRect().width + 16;
      track.scrollBy({ left: direction * amount, behavior: 'smooth' });
    }

    if (prevBtn) prevBtn.addEventListener('click', function () { scrollByAmount(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { scrollByAmount(1); });

    /* ---------- Lightbox ---------- */
    var root = track.closest('.installation-gallery');
    var modal = root.querySelector('.installation-gallery__modal');
    if (!modal) return;

    // Purani copy (theme editor re-render) hata do, phir body me move karo
    document.querySelectorAll('body > .installation-gallery__modal[data-modal-for="' + sectionId + '"]').forEach(function (el) {
      el.remove();
    });
    document.body.appendChild(modal);

    var imgEl = modal.querySelector('.installation-gallery__modal-img');
    var captionEl = modal.querySelector('.installation-gallery__modal-caption');
    var counterEl = modal.querySelector('.installation-gallery__modal-counter');
    var triggers = track.querySelectorAll('[data-gallery-open]');
    var items = [];
    var current = 0;
    var lastFocus = null;

    triggers.forEach(function (btn, i) {
      items.push({
        src: btn.getAttribute('data-full'),
        alt: btn.getAttribute('data-alt') || '',
        caption: btn.getAttribute('data-caption') || ''
      });
      btn.addEventListener('click', function () { openModal(i); });
    });

    function show(index) {
      if (!items.length) return;
      current = (index + items.length) % items.length;
      var item = items[current];
      imgEl.src = item.src;
      imgEl.alt = item.alt;
      captionEl.textContent = item.caption;
      counterEl.textContent = (current + 1) + ' / ' + items.length;

      // Aage-peeche wali image preload
      [current + 1, current - 1].forEach(function (n) {
        var it = items[(n + items.length) % items.length];
        if (it) { var pre = new Image(); pre.src = it.src; }
      });
    }

    function openModal(index) {
      lastFocus = document.activeElement;
      modal.hidden = false;
      document.body.classList.add('installation-gallery-lock');
      show(index);
      modal.querySelector('.installation-gallery__modal-close').focus();
      document.addEventListener('keydown', onKey);
    }

    function closeModal() {
      modal.hidden = true;
      imgEl.src = '';
      document.body.classList.remove('installation-gallery-lock');
      document.removeEventListener('keydown', onKey);
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    function onKey(e) {
      if (e.key === 'Escape') closeModal();
      else if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
    }

    modal.querySelector('[data-modal-prev]').addEventListener('click', function () { show(current - 1); });
    modal.querySelector('[data-modal-next]').addEventListener('click', function () { show(current + 1); });
    modal.querySelectorAll('[data-modal-close]').forEach(function (el) {
      el.addEventListener('click', closeModal);
    });

    // Mobile swipe
    var startX = 0;
    modal.addEventListener('touchstart', function (e) {
      startX = e.changedTouches[0].clientX;
    }, { passive: true });
    modal.addEventListener('touchend', function (e) {
      var diff = e.changedTouches[0].clientX - startX;
      if (Math.abs(diff) > 50) show(diff > 0 ? current - 1 : current + 1);
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Installation Gallery",
  "tag": "section",
  "class": "section-installation-gallery",
  "settings": [
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Installation Gallery"
    },
    {
      "type": "richtext",
      "id": "sub_heading",
      "label": "Sub heading",
      "default": "<p>Take a look at some of our recent installations across the Las Vegas Valley.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See More Installations"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Link to your portfolio page"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Installation Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}