{% comment %}
  Community Appreciation Discount: slim full-width strip above the footer.
{% endcomment %}

{%- assign groups = 'Active-Duty Military & Veterans|Law Enforcement|Teachers & Educators|Firefighters|Local, State & Federal Government Employees|EMTs & Paramedics|Seniors 65+|Attorneys' | split: '|' -%}

<div class="vtm-community">
  <div class="vtm-community__inner page-width">
    <div class="vtm-community__lead">
      <span class="vtm-community__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
      </span>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="vtm-community__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="vtm-community__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    </div>

    <div class="vtm-community__details">
      <ul class="vtm-community__groups" role="list">
        {%- for group in groups -%}
          <li>{{ group }}</li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.note != blank -%}
        <p class="vtm-community__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .vtm-community {
    position: relative;
    background:
      radial-gradient(500px 160px at 0% 50%, rgba(224, 43, 43, 0.22), transparent 70%),
      linear-gradient(90deg, #120404, #0a0a0a 45%);
    border-top: 1px solid rgba(224, 43, 43, 0.45);
    color: #fff;
  }

  .vtm-community__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 36px;
    padding-top: 18px;
    padding-bottom: 18px;
  }

  .vtm-community__lead {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-right: 36px;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
  }

  .vtm-community__icon {
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: rgba(224, 43, 43, 0.16);
    color: #ff5a5a;
  }

  .vtm-community__eyebrow {
    margin: 0 0 2px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ff5a5a;
  }

  .vtm-community__heading {
    margin: 0;
    font-size: 20px;
    line-height: 1.2;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
  }

  .vtm-community__heading::after {
    display: none !important;
  }

  .vtm-community__heading strong {
    color: #4ade80;
  }

  .vtm-community__groups {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.85);
  }

  .vtm-community__groups li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .vtm-community__groups li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #4ade80;
  }

  .vtm-community__note {
    margin: 6px 0 0;
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.5);
  }

  @media screen and (max-width: 749px) {
    .vtm-community__inner {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-top: 20px;
      padding-bottom: 20px;
    }

    .vtm-community__lead {
      padding-right: 0;
      border-right: 0;
    }

    .vtm-community__heading {
      font-size: 18px;
      white-space: normal;
    }

    .vtm-community__groups {
      gap: 4px 14px;
      font-size: 12.5px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Community Appreciation",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Community image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Community Appreciation Discount"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Automatically Save <strong>10%</strong>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Our way of saying thank you to those who serve our community.</p>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Fine print",
      "default": "Valid identification or proof of eligibility required at time of service. Cannot be combined with other offers."
    }
  ],
  "presets": [
    {
      "name": "Community Appreciation"
    }
  ]
}
{% endschema %}