{% style %}
  #shopify-section-{{ section.id }} {
    padding: 48px 20px;
  }

  #shopify-section-{{ section.id }} .community-appreciation {
    max-width: 1280px;
    margin: 0 auto;
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-top: 4px solid #d71920;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 18px 55px rgba(0, 0, 0, 0.16);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .community-appreciation__image {
    padding: 18px;
  }

  #shopify-section-{{ section.id }} .community-appreciation__image img {
    width: 100%;
    height: 100%;
    min-height: 430px;
    display: block;
    object-fit: cover;
    border-radius: 18px;
  }

  #shopify-section-{{ section.id }} .community-appreciation__placeholder {
    min-height: 430px;
    background: #161616;
    border-radius: 18px;
  }

  #shopify-section-{{ section.id }} .community-appreciation__content {
    padding: 56px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .community-appreciation__eyebrow {
    color: #d71920;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    margin: 0 0 14px;
  }

  #shopify-section-{{ section.id }} .community-appreciation__heading {
    color: #fff;
    font-size: clamp(36px, 4vw, 52px);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -1.2px;
    margin: 0 0 18px;
  }

  #shopify-section-{{ section.id }} .community-appreciation__heading strong {
    color: #d71920;
  }

  #shopify-section-{{ section.id }} .community-appreciation__text {
    color: #e8e8e8;
    font-size: 17px;
    line-height: 1.65;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .community-appreciation__groups {
    color: #fff;
    font-size: 15px;
    line-height: 1.75;
    font-weight: 600;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .community-appreciation__note {
    color: #a8a8a8;
    font-size: 12px;
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} {
      padding: 30px 16px;
    }

    #shopify-section-{{ section.id }} .community-appreciation {
      grid-template-columns: 1fr;
      border-radius: 20px;
    }

    #shopify-section-{{ section.id }} .community-appreciation__image {
      padding: 14px;
    }

    #shopify-section-{{ section.id }} .community-appreciation__image img,
    #shopify-section-{{ section.id }} .community-appreciation__placeholder {
      min-height: 300px;
      aspect-ratio: 16 / 10;
    }

    #shopify-section-{{ section.id }} .community-appreciation__content {
      padding: 34px 28px 40px;
    }

    #shopify-section-{{ section.id }} .community-appreciation__heading {
      font-size: 36px;
    }
  }
{% endstyle %}

<div class="community-appreciation">
  <div class="community-appreciation__image">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 1400
        | image_tag:
          loading: 'lazy',
          widths: '500, 750, 1000, 1400',
          sizes: '(min-width: 901px) 50vw, 100vw',
          alt: section.settings.image.alt
      }}
    {% else %}
      <div class="community-appreciation__placeholder"></div>
    {% endif %}
  </div>

  <div class="community-appreciation__content">
    {% if section.settings.eyebrow != blank %}
      <p class="community-appreciation__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="community-appreciation__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="community-appreciation__text">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.groups != blank %}
      <div class="community-appreciation__groups">
        {{ section.settings.groups }}
      </div>
    {% endif %}

    {% if section.settings.note != blank %}
      <p class="community-appreciation__note">
        {{ section.settings.note }}
      </p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Community Appreciation",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Community image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Community Appreciation Discount"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Save <strong>10%</strong> on Your Service"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Our way of saying thank you to those who serve our community.</p>"
    },
    {
      "type": "richtext",
      "id": "groups",
      "label": "Eligible groups",
      "default": "<p>Active-Duty Military • Veterans • Teachers & Educators • Law Enforcement • Firefighters • EMTs & Paramedics • Local, State & Federal Government Employees</p>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Fine print",
      "default": "Valid identification or proof of eligibility required at time of service. Cannot be combined with other offers."
    }
  ],
  "presets": [
    {
      "name": "Community Appreciation"
    }
  ]
}
{% endschema %}