{%- style -%}
  #section-perfect-for-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #section-perfect-for-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

<div id="section-perfect-for-{{ section.id }}" class="color-{{ section.settings.color_scheme }} pf-section">
  <div class="page-width">
    <div class="pf-grid">

      <div class="pf-column">
        {%- if section.settings.left_heading != blank -%}
          <h3 class="pf-heading">
            <svg class="pf-diamond" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="10" y="1.5" width="12" height="12" rx="2" transform="rotate(45 10 1.5)" stroke="currentColor" stroke-width="1.6"/>
            </svg>
            {{ section.settings.left_heading }}
          </h3>
        {%- endif -%}
        <ul class="pf-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'left_item' -%}
              <li class="pf-list-item" {{ block.shopify_attributes }}>
                <svg class="pf-check" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- if section.settings.image != blank -%}
        <div class="pf-image-wrap">
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'pf-image', sizes: '(min-width: 750px) 40vw, 100vw', widths: '400,600,800,1000,1200' }}
        </div>
      {%- endif -%}

      <div class="pf-column">
        {%- if section.settings.right_heading != blank -%}
          <h3 class="pf-heading">
            <svg class="pf-diamond" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="10" y="1.5" width="12" height="12" rx="2" transform="rotate(45 10 1.5)" stroke="currentColor" stroke-width="1.6"/>
            </svg>
            {{ section.settings.right_heading }}
          </h3>
        {%- endif -%}
        <ul class="pf-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'right_item' -%}
              <li class="pf-list-item" {{ block.shopify_attributes }}>
                <svg class="pf-check" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Perfect For / Why Choose",
  "tag": "section",
  "class": "section-perfect-for",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "left_heading",
      "label": "Left heading",
      "default": "Perfect For"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Center image"
    },
    {
      "type": "text",
      "id": "right_heading",
      "label": "Right heading",
      "default": "Why Choose Us?"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "left_item",
      "name": "Left list item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Dedicated home theaters"
        }
      ]
    },
    {
      "type": "right_item",
      "name": "Right list item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Local company"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perfect For / Why Choose",
      "settings": {
        "left_heading": "Perfect For",
        "right_heading": "Why Choose Vegas TV Mounting?"
      },
      "blocks": [
        { "type": "left_item", "settings": { "text": "Dedicated home theaters" } },
        { "type": "left_item", "settings": { "text": "Media rooms & basements" } },
        { "type": "left_item", "settings": { "text": "Living rooms & great rooms" } },
        { "type": "left_item", "settings": { "text": "Gaming rooms" } },
        { "type": "left_item", "settings": { "text": "New construction & remodels" } },
        { "type": "right_item", "settings": { "text": "Local Las Vegas Company" } },
        { "type": "right_item", "settings": { "text": "Experienced, Professional Installers" } },
        { "type": "right_item", "settings": { "text": "Top-Rated Service & Reviews" } },
        { "type": "right_item", "settings": { "text": "Upfront Pricing – No Surprises" } },
        { "type": "right_item", "settings": { "text": "5 Year Installation Warranty" } }
      ]
    }
  ]
}
{% endschema %}