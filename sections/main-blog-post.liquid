<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class=" color-{{ section.settings.color_scheme }}">

  {%- comment -%} ============ BANNER ============ {%- endcomment -%}
  <div
    class="blog-post-banner{% if section.settings.banner_padding_mobile %} blog-post-banner--mobile-padding{% endif %}"
    style="
      --banner-padding-top: {{ section.settings.banner_padding_top }}px;
      --banner-padding-bottom: {{ section.settings.banner_padding_bottom }}px;
      --banner-padding-top-mobile: {{ section.settings.banner_padding_top_mobile }}px;
      --banner-padding-bottom-mobile: {{ section.settings.banner_padding_bottom_mobile }}px;
    "
  >
     <div class=page-width">
       <div class="blog-post-banner__inner">
   
         {%- if section.settings.show_breadcrumbs -%}
           <nav class="blog-post-breadcrumbs" aria-label="breadcrumb">
             <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t: default: 'Home' }}</a>
             <span class="blog-post-breadcrumbs__sep">/</span>
             <a href="{{ blog.url }}">{{ blog.title }}</a>
             <span class="blog-post-breadcrumbs__sep">/</span>
             <span class="blog-post-breadcrumbs__current">{{ article.title }}</span>
           </nav>
         {%- endif -%}
   
         <h1 class="blog-post-banner__title">{{ article.title }}</h1>
   
         <div class="blog-post-banner__meta">
           <span class="blog-post-banner__meta-item">
             <svg class="icon icon-calendar" viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
               <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
               <path d="M3 9.5H21" stroke="currentColor" stroke-width="1.5"/>
               <path d="M8 3V6.5M16 3V6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
             </svg>
             <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
               {{ article.published_at | time_tag: format: 'date' }}
             </time>
           </span>
   
           <span class="blog-post-banner__meta-item">
             <svg class="icon icon-clock" viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
               <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
               <path d="M12 7V12L15.5 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
             </svg>
             {%- assign words = article.content | strip_html | split: ' ' | size -%}
             {%- assign read_time = words | divided_by: 200 -%}
             {%- if read_time < 1 -%}{%- assign read_time = 1 -%}{%- endif -%}
             <span>{{ read_time }} {{ 'blogs.article.min_read' | t: default: 'min read' }}</span>
           </span>
         </div>
   
       </div>
     </div>
  </div>

  {%- comment -%} ============ MAIN LAYOUT: content + sidebar ============ {%- endcomment -%}
  <div
    class="
      spacing-style
      section-content-wrapper
      blog-post-layout
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    <div class="blog-post-layout__main">
      {%- if article.image -%}
        {%- content_for 'block', id: 'blog-post-image', type: '_blog-post-featured-image' %}
      {%- endif -%}

      <div id="blog-post-content-wrapper">
        {%- content_for 'block', id: 'blog-post-content', type: '_blog-post-content' %}
      </div>
    </div>

    <aside class="blog-post-layout__sidebar">
      <div class="blog-post-sidebar-inner">

        {%- if section.settings.show_toc -%}
          <div class="blog-post-toc" id="blog-post-toc">
            <h2 class="blog-post-toc__title">{{ section.settings.toc_heading | default: 'Table of Contents' }}</h2>
            <ul class="blog-post-toc__list" id="blog-post-toc-list">
              {%- comment -%} populated by JS from headings inside the article content {%- endcomment -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.settings.show_related -%}
          <div class="blog-post-related">
            <h2 class="blog-post-related__title">{{ section.settings.related_heading | default: 'Related Posts' }}</h2>
            <div class="blog-post-related__list">
              {%- assign related_count = 0 -%}
              {%- for related_article in blog.articles -%}
                {%- if related_article.id != article.id and related_count < section.settings.related_count -%}
                  {%- assign related_count = related_count | plus: 1 -%}
                  <a href="{{ related_article.url }}" class="blog-post-related__item">
                    {%- if related_article.image -%}
                      <div class="blog-post-related__image">
                        {{ related_article.image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,200' }}
                      </div>
                    {%- endif -%}
                    <div class="blog-post-related__content">
                      <span class="blog-post-related__item-title">{{ related_article.title }}</span>
                      <time class="blog-post-related__item-date" datetime="{{ related_article.published_at | date: '%Y-%m-%d' }}">
                        {{ related_article.published_at | time_tag: format: 'date' }}
                      </time>
                    </div>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

      </div>
    </aside>
  </div>

  {% comment %} Dynamic area for @app blocks only, at the bottom {% endcomment %}
  {% content_for 'blocks' %}

  {% if blog.comments_enabled? %}
    <div class="blog-post-comments-container">
      <h2 class="h3">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

      <div class="blog-post-comments">
        {% paginate article.comments by 10 %}
          {% for comment in article.comments %}
            <div class="blog-post-comment">
              {{ comment.content }}
              <div class="blog-post-comment__author">
                <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                <span class="blog-post-comment__date">
                  {{- comment.created_at | time_tag: format: 'date' -}}
                </span>
              </div>
            </div>
          {% endfor %}

          <div class="blog-post-comments-pagination">
            {{- paginate | default_pagination -}}
          </div>
        {% endpaginate %}
      </div>

      {% render 'blog-comment-form', article: article, section_id: section.id %}
    </div>
  {% endif %}
</div>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{%- if section.settings.show_toc -%}
<script>
  (function () {
    var content = document.getElementById('blog-post-content-wrapper');
    var tocList = document.getElementById('blog-post-toc-list');
    var tocBlock = document.getElementById('blog-post-toc');
    if (!content || !tocList) return;

    var headings = content.querySelectorAll('h2, h3');
    if (!headings.length) {
      if (tocBlock) tocBlock.style.display = 'none';
      return;
    }

    headings.forEach(function (heading, index) {
      var id = 'toc-heading-' + index;
      heading.id = id;

      var li = document.createElement('li');
      li.className = 'blog-post-toc__item blog-post-toc__item--' + heading.tagName.toLowerCase();

      var link = document.createElement('a');
      link.href = '#' + id;
      link.textContent = heading.textContent;
      link.addEventListener('click', function (e) {
        e.preventDefault();
        heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      li.appendChild(link);
      tocList.appendChild(li);
    });
  })();
</script>
{%- endif -%}

{% stylesheet %}
  /* ============ BANNER ============ */
  .blog-post-banner {
    width: 100%;
    padding-top: var(--banner-padding-top);
    padding-bottom: var(--banner-padding-bottom);
  }
.blog-post-banner__inner {
    width: 100%;
    max-width: 750px;
    margin: 0;
    padding-inline: var(--padding-lg, 20px);
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs, 8px);
}blog-post-banner
  .blog-post-breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-3xs, 4px);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .blog-post-breadcrumbs a:hover {
    text-decoration: underline;
  }

  .blog-post-breadcrumbs__current {
    color: var(--color-foreground);
  }

  .blog-post-banner__title {
    margin: 0;
  }

  .blog-post-banner__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-lg, 16px);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-banner__meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-3xs, 6px);
  }

  .blog-post-banner__meta-item .icon {
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .blog-post-banner--mobile-padding {
      padding-top: var(--banner-padding-top-mobile);
      padding-bottom: var(--banner-padding-bottom-mobile);
    }
  }

  /* ============ LAYOUT: main + sidebar ============ */
  .blog-post-layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--gap-3xl, 40px);
    align-items: start;
  }

  .blog-post-layout__main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl, 24px);
  }

  .blog-post-layout__sidebar {
    position: sticky;
    top: var(--gap-xl, 24px);
  }

  .blog-post-sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xl, 32px);
  }

  @media screen and (max-width: 989px) {
    .blog-post-layout {
      grid-template-columns: 1fr;
    }

    .blog-post-layout__sidebar {
      position: static;
    }
  }

  /* ============ TOC ============ */
  .blog-post-toc {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-border, 0.15));
    border-radius: var(--radius, 8px);
    padding: var(--padding-lg, 20px);
  }

  .blog-post-toc__title {
    margin: 0 0 var(--margin-md, 12px);
    font-size: var(--font-size--body-md);
  }

  .blog-post-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs, 8px);
  }

  .blog-post-toc__item a {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    text-decoration: none;
    font-size: var(--font-size--body-sm);
    display: block;
  }

  .blog-post-toc__item a:hover {
    color: var(--color-foreground);
    text-decoration: underline;
  }

  .blog-post-toc__item--h3 {
    padding-inline-start: var(--padding-md, 14px);
  }

  /* ============ RELATED POSTS ============ */
  .blog-post-related__title {
    margin: 0 0 var(--margin-md, 12px);
    font-size: var(--font-size--body-md);
  }

  .blog-post-related__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg, 16px);
  }

  .blog-post-related__item {
    display: flex;
    gap: var(--gap-sm, 12px);
    text-decoration: none;
    color: inherit;
  }

  .blog-post-related__image {
    width: 80px;
    flex-shrink: 0;
    border-radius: var(--radius, 6px);
    overflow: hidden;
  }

  .blog-post-related__image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .blog-post-related__content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs, 4px);
    justify-content: center;
  }

  .blog-post-related__item-title {
    font-size: var(--font-size--body-sm);
    font-weight: 600;
    line-height: 1.3;
  }

  .blog-post-related__item:hover .blog-post-related__item-title {
    text-decoration: underline;
  }

  .blog-post-related__item-date {
    font-size: var(--font-size--body-xs, 12px);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  /* ============ COMMENTS (unchanged) ============ */
  .blog-post-comments-container {
    width: 100%;
    max-width: var(--normal-content-width);
    margin: 0 auto;
  }

  .blog-post-comments {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .blog-post-comment__author {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin-top: var(--margin-md);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-comments-pagination {
    display: flex;
    justify-content: center;
    gap: var(--gap-2xs);
  }

  .blog-post-comments-pagination,
  .blog-post-comments-pagination a {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a {
    display: block;
    padding: var(--padding-2xs) var(--padding-xs);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a:hover {
    border-bottom: 1px solid var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "range",
      "id": "banner_padding_top",
      "label": "Banner padding top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "banner_padding_bottom",
      "label": "Banner padding bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "banner_padding_mobile",
      "label": "Use separate padding on mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "banner_padding_top_mobile",
      "label": "Banner padding top (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.banner_padding_mobile }}"
    },
    {
      "type": "range",
      "id": "banner_padding_bottom_mobile",
      "label": "Banner padding bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.banner_padding_mobile }}"
    },
    {
      "type": "header",
      "content": "Table of Contents"
    },
    {
      "type": "checkbox",
      "id": "show_toc",
      "label": "Show table of contents",
      "default": true
    },
    {
      "type": "text",
      "id": "toc_heading",
      "label": "Heading",
      "default": "Table of Contents"
    },
    {
      "type": "header",
      "content": "Related Posts"
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Show related posts",
      "default": true
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "Heading",
      "default": "Related Posts"
    },
    {
      "type": "range",
      "id": "related_count",
      "label": "Number of related posts",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": []
}
{% endschema %}