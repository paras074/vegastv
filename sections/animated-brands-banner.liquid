{% comment %}
  Vegas TV Mounting — Animated Brands Banner
  Save as: sections/animated-brands-banner.liquid
{% endcomment %}

<section id="animated-brands-banner-{{ section.id }}" class="vtm-brand-marquee color-{{ section.settings.color_scheme }}">
  <div class="vtm-brand-marquee__inner">

    {% if section.settings.heading != blank %}
      <h2 class="vtm-brand-marquee__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="vtm-brand-marquee__subheading">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    <div
      class="vtm-brand-marquee__viewport"
      style="
        --marquee-duration: {{ section.settings.speed }}s;
        --logo-gap: {{ section.settings.logo_gap }}px;
        --logo-height: {{ section.settings.logo_height }}px;
      "
    >
      <div class="vtm-brand-marquee__track">

        <div class="vtm-brand-marquee__group">
          {% for block in section.blocks %}
            <div class="vtm-brand-marquee__item" {{ block.shopify_attributes }}>

              {% if block.settings.link != blank %}
                <a
                  class="vtm-brand-marquee__link"
                  href="{{ block.settings.link }}"
                  aria-label="{{ block.settings.brand_name | escape }}"
                >
              {% endif %}

              {% if block.settings.logo != blank %}
                {{
                  block.settings.logo
                  | image_url: width: 400
                  | image_tag:
                    loading: 'lazy',
                    widths: '120, 180, 240, 320, 400',
                    sizes: '160px',
                    class: 'vtm-brand-marquee__logo',
                    alt: block.settings.brand_name
                }}
              {% else %}
                <span class="vtm-brand-marquee__name">
                  {{ block.settings.brand_name }}
                </span>
              {% endif %}

              {% if block.settings.link != blank %}
                </a>
              {% endif %}

            </div>
          {% endfor %}
        </div>

        <div class="vtm-brand-marquee__group" aria-hidden="true">
          {% for block in section.blocks %}
            <div class="vtm-brand-marquee__item">

              {% if block.settings.logo != blank %}
                {{
                  block.settings.logo
                  | image_url: width: 400
                  | image_tag:
                    loading: 'lazy',
                    widths: '120, 180, 240, 320, 400',
                    sizes: '160px',
                    class: 'vtm-brand-marquee__logo',
                    alt: ''
                }}
              {% else %}
                <span class="vtm-brand-marquee__name">
                  {{ block.settings.brand_name }}
                </span>
              {% endif %}

            </div>
          {% endfor %}
        </div>

      </div>
    </div>

    {% if section.settings.bottom_text != blank %}
      <p class="vtm-brand-marquee__bottom-text">
        {{ section.settings.bottom_text }}
      </p>
    {% endif %}

    {% if section.settings.show_disclaimer %}
      <p class="vtm-brand-marquee__disclaimer">
        All trademarks and logos are the property of their respective owners.
        Vegas TV Mounting is an independent installation company and is not
        affiliated with or endorsed by these manufacturers unless otherwise stated.
      </p>
    {% endif %}

  </div>
</section>

{% style %}

  #animated-brands-banner-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  overflow: hidden;
  border-top: 1px solid rgba(0, 0, 0, 0.10);
  border-bottom: 1px solid rgba(0, 0, 0, 0.10);
}

  #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__inner {
    width: 100%;
  }

  #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__heading {
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__subheading {
    max-width: 760px;
    margin: 10px auto 0;
    padding: 0 20px;
    text-align: center;
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.76;
  }

  #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__viewport {
    position: relative;
    width: 100%;
    margin-top: 24px;
    overflow: hidden;

    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );

    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
  }

  #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__track {
    display: flex;
    width: max-content;
    animation:
      vtm-brand-scroll-{{ section.id }}
      var(--marquee-duration)
      linear
      infinite;
    will-change: transform;
  }

  #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: var(--logo-gap);
    padding-right: var(--logo-gap);
  }

#animated-brands-banner-{{ section.id }} .vtm-brand-marquee__item {
  flex: 0 0 180px;
  width: 180px;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px 18px;
  box-sizing: border-box;
}

  #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__logo {
  display: block;
  width: 150px;
  height: var(--logo-height);
  max-width: 150px;
  object-fit: contain;
  object-position: center;
  filter: none;
  opacity: 1;
  transform: translateZ(0);
}

  #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__name {
    white-space: nowrap;
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
  }

  #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__bottom-text {
    margin: 18px auto 0;
    padding: 0 20px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
  }

  #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__disclaimer {
    max-width: 900px;
    margin: 10px auto 0;
    padding: 0 20px;
    text-align: center;
    font-size: 10px;
    line-height: 1.5;
    opacity: 0.55;
  }

  {% if section.settings.pause_on_hover %}
    @media (hover: hover) and (pointer: fine) {
      #animated-brands-banner-{{ section.id }}
      .vtm-brand-marquee__viewport:hover
      .vtm-brand-marquee__track {
        animation-play-state: paused;
      }
    }
  {% endif %}

  @keyframes vtm-brand-scroll-{{ section.id }} {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media screen and (max-width: 749px) {

    #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__viewport {
      margin-top: 18px;

      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 4%,
        #000 96%,
        transparent 100%
      );

      mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 4%,
        #000 96%,
        transparent 100%
      );
    }

    #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__item {
  flex-basis: 140px;
  width: 140px;
  height: 68px;
  padding: 8px 12px;
}

#animated-brands-banner-{{ section.id }} .vtm-brand-marquee__logo {
  width: 120px;
  max-width: 120px;
  height: calc(var(--logo-height) * 0.85);
}

    #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__name {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {

    #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__viewport {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
      scrollbar-width: thin;
    }

    #animated-brands-banner-{{ section.id }} .vtm-brand-marquee__track {
      animation: none;
    }

    #animated-brands-banner-{{ section.id }}
    .vtm-brand-marquee__group[aria-hidden="true"] {
      display: none;
    }
  }

{% endstyle %}

{% schema %}
{
  "name": "Animated brands banner",
  "class": "section-an",
  "max_blocks": 20,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Leading Brands We Install"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>We professionally install and configure televisions, audio equipment, streaming devices, mounts, and smart-home products from today’s leading brands.</p>"
    },
    {
      "type": "inline_richtext",
      "id": "bottom_text",
      "label": "Bottom text",
      "default": "Don’t see your brand? We install and support virtually all major TV, audio, streaming, mounting, and smart-home brands."
    },
    {
      "type": "checkbox",
      "id": "show_disclaimer",
      "label": "Show trademark disclaimer",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on desktop hover",
      "default": true
    },
    {
  "type": "range",
  "id": "speed",
  "label": "Scroll speed",
  "min": 20,
  "max": 100,
  "step": 5,
  "unit": "s",
  "default": 60,
  "info": "Higher values scroll more slowly."
},
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 24,
      "max": 72,
      "step": 4,
      "unit": "px",
