
{%- style -%}
  #section-home-theater-services-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #section-home-theater-services-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

<div id="section-home-theater-services-{{ section.id }}" class="color-{{ section.settings.color_scheme }} hts-section">
  <div class="page-width">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="hts-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="hts-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="hts-subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="hts-grid" style="--hts-columns: {{ section.blocks.size }};">
        {%- for block in section.blocks -%}
          <div class="hts-item" {{ block.shopify_attributes }}>
            <div class="hts-icon">
              {%- case block.settings.icon -%}
                {%- when 'monitor' -%}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="6" y="9" width="36" height="24" rx="2" stroke="currentColor" stroke-width="2.2"/>
                    <path d="M17 41h14M24 33v8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                    <path d="M40 12l5-4M40 16h6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                  </svg>
                {%- when 'speaker' -%}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="12" y="4" width="24" height="40" rx="4" stroke="currentColor" stroke-width="2.2"/>
                    <circle cx="24" cy="16" r="5" stroke="currentColor" stroke-width="2.2"/>
                    <circle cx="24" cy="32" r="7" stroke="currentColor" stroke-width="2.2"/>
                    <circle cx="24" cy="32" r="2.4" fill="currentColor"/>
                  </svg>
                {%- when 'plug' -%}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6v10M30 6v10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                    <path d="M14 16h20v6a10 10 0 0 1-20 0v-6z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
                    <path d="M24 32v6c0 3-3 4-3 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                  </svg>
                {%- else -%}
                  {%- if block.settings.custom_icon != blank -%}
                    <img src="{{ block.settings.custom_icon | image_url: width: 96 }}" alt="" width="40" height="40" loading="lazy">
                  {%- endif -%}
              {%- endcase -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="hts-item-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="hts-item-text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Installation Services",
  "tag": "section",
  "class": "section-home-theater-services",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Home Theater Installation Services"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>We design and install custom home theater systems that bring the cinema experience to your home in Las Vegas and surrounding areas.</p>"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "monitor", "label": "Monitor" },
            { "value": "speaker", "label": "Speaker" },
            { "value": "plug", "label": "Plug" },
            { "value": "custom", "label": "Custom image" }
          ],
          "default": "monitor"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon image",
          "info": "Used when icon is set to Custom image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Custom Designed"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Every space is unique. We design a system that fits your room, style, and budget.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Installation Services",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "monitor",
            "title": "Custom Designed",
            "text": "<p>Every space is unique. We design a system that fits your room, style, and budget.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "speaker",
            "title": "Premium Audio & Video",
            "text": "<p>High-performance TVs, projectors, receivers, and speakers for the best experience.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "plug",
            "title": "Clean & Hidden Wiring",
            "text": "<p>We conceal all wires and components for a clean, modern look.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}