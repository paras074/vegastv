<div
  class="home-types color-{{ section.settings.color_scheme }}"
  style="
    --padding-top-desktop: {{ section.settings.padding_top }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="home-types__wrapper page-width">
    {% if section.settings.heading != blank %}
      <h2 class="home-types__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <div class="home-types__description">{{ section.settings.description }}</div>
    {% endif %}

    <div class="home-types__grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'card' %}
            <div class="home-types__card" {{ block.shopify_attributes }}>
              <div class="home-types__icon">
                {% case block.settings.icon %}
                  {% when 'home' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg>
                  {% when 'wrench' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.65 2.65a1 1 0 0 1-1.4 0l-1.6-1.6a1 1 0 0 1 0-1.4Z"/></svg>
                  {% when 'ruler' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 16 5-5 3 3 5-5 5 5"/><path d="M3 21h18"/></svg>
                  {% when 'layers' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/></svg>
                  {% when 'building' %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="22" viewBox="0 0 24 22" fill="none">
                      <path d="M19.2 14.6667H16.8V17.1111H19.2M19.2 9.77778H16.8V12.2222H19.2M21.6 19.5556H12V17.1111H14.4V14.6667H12V12.2222H14.4V9.77778H12V7.33333H21.6M9.6 4.88889H7.2V2.44444H9.6M9.6 9.77778H7.2V7.33333H9.6M9.6 14.6667H7.2V12.2222H9.6M9.6 19.5556H7.2V17.1111H9.6M4.8 4.88889H2.4V2.44444H4.8M4.8 9.77778H2.4V7.33333H4.8M4.8 14.6667H2.4V12.2222H4.8M4.8 19.5556H2.4V17.1111H4.8M12 4.88889V0H0V22H24V4.88889H12Z" fill="#fff"/>
                      </svg>
                {% endcase %}
              </div>

              <h3 class="home-types__card-heading">{{ block.settings.heading }}</h3>

              {% if block.settings.list_items != blank %}
                <ul class="home-types__list">
                  {% assign list_items = block.settings.list_items | newline_to_br | split: '<br />' %}
                    {% for line in list_items %}
                    {% assign trimmed_line = line | strip %}
                    {% if trimmed_line != blank %}
                      <li>
                        <svg class="home-types__check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg>
                        <span>{{ trimmed_line }}</span>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              {% endif %}

              {% if block.settings.note_label_1 != blank or block.settings.note_label_2 != blank %}
                <div class="home-types__notes">
                  {% if block.settings.note_label_1 != blank %}
                    <p><span class="home-types__note-label">{{ block.settings.note_label_1 }}:</span> {{ block.settings.note_text_1 }}</p>
                  {% endif %}
                  {% if block.settings.note_label_2 != blank %}
                    <p><span class="home-types__note-label">{{ block.settings.note_label_2 }}:</span> {{ block.settings.note_text_2 }}</p>
                  {% endif %}
                </div>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Home types cards",
  "class": "section-home",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common Home Types in Las Vegas"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Las Vegas's housing stock spans from 1950s ranch homes in established neighborhoods to sprawling modern two-story traditionals in master-planned communities.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "home", "label": "Home" },
            { "value": "wrench", "label": "Wrench" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "layers", "label": "Layers" },
            { "value": "building", "label": "Building" }
          ],
          "default": "home"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Card heading",
          "default": "Home Styles We Work In"
        },
        {
          "type": "textarea",
          "id": "list_items",
          "label": "List items",
          "info": "One item per line",
          "default": "Two-story traditional\nRanch homes\nTownhomes\nSplit-level homes\nNew construction\nCustom luxury homes"
        },
        {
          "type": "header",
          "content": "Optional footer notes"
        },
        {
          "type": "text",
          "id": "note_label_1",
          "label": "Note 1 label",
          "default": "Typical size"
        },
        {
          "type": "text",
          "id": "note_text_1",
          "label": "Note 1 text",
          "default": "1,200-5,000 sq ft"
        },
        {
          "type": "text",
          "id": "note_label_2",
          "label": "Note 2 label",
          "default": "Housing era"
        },
        {
          "type": "text",
          "id": "note_text_2",
          "label": "Note 2 text",
          "default": "1950s established neighborhoods to 2020s new builds"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home types cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon": "home",
            "heading": "Home Styles We Work In",
            "list_items": "Two-story traditional\nRanch homes\nTownhomes\nSplit-level homes\nNew construction\nCustom luxury homes",
            "note_label_1": "",
            "note_label_2": ""
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "wrench",
            "heading": "Wall Types We Mount On",
            "list_items": "Standard drywall\nBrick fireplace surrounds\nStone accent walls\nPainted brick\nTextured drywall",
            "note_label_1": "Typical size",
            "note_text_1": "1,200-5,000 sq ft",
            "note_label_2": "Housing era",
            "note_text_2": "1950s established neighborhoods to 2020s new builds"
          }
        }
      ]
    }
  ]
}
{% endschema %}