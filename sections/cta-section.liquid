<div
  class="cta-section color-{{ section.settings.color_scheme }}"
  style="
    --pt-desktop: {{ section.settings.padding_top }}px;
    --pb-desktop: {{ section.settings.padding_bottom }}px;
    --pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --pb-mobile: {{ section.settings.padding_bottom_mobile }}px; ">
  <div class="cta-section__container page-width">
    <div class="cta-head">
        {%- if section.settings.heading != blank -%}
        <h2 class="cta-section__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.sub_heading != blank -%}
        <div class="cta-section__sub-heading">{{ section.settings.sub_heading }}</div>
        {%- endif -%}
    </div>
     {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
          <div class="hero-section__buttons cta-buttons">
            {%- if section.settings.button_1_label != blank -%}
              <a
                {% if section.settings.button_1_link != blank %}
                  href="{{ section.settings.button_1_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="btn-primary">
                <span class="gold-phone-button__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </span> 
                <span>{{ section.settings.button_1_label }}</span>
              </a>
            {%- endif -%}

            {%- if section.settings.button_2_label != blank -%}
              <a
                {% if section.settings.button_2_link != blank %}
                  href="{{ section.settings.button_2_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="btn-secondary js-connect-popup ">
                <span class="gold-phone-button__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                </span> 
                <span>{{ section.settings.button_2_label }}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "CTA section",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to get started?"
    },
    {
      "type": "richtext",
      "id": "sub_heading",
      "label": "Sub heading",
      "default": "<p>Book your installation today and see the difference.</p>"
    },
     {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "CTA section"
    }
  ]
}
{% endschema %}