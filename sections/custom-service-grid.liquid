            },
            {
              "value": "commercial",
              "label": "Commercial"
            }
          ],
          "default": "residential"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Service image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Service title",
          "default": "Service title"
        },
        {
          "type": "header",
          "content": "Book Service link"
        },
        {
          "type": "text",
          "id": "book_label",
          "label": "Book link text",
          "default": "Book Service"
