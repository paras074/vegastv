<div
  class="process-steps color-{{ section.settings.color_scheme }}"
  style="
    --padding-top-desktop: {{ section.settings.padding_top }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="process-steps__wrapper page-width">
    {% if section.settings.heading != blank %}
      <h2 class="process-steps__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="process-steps__grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'step' %}
            <div class="process-steps__card" {{ block.shopify_attributes }}>
              <div class="process-steps__icon-wrap">
                <div class="process-steps__icon">
                  {% case block.settings.icon %}
                    {% when 'clipboard' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3"/></svg>
                    {% when 'clipboard-check' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3"/><path d="m9 14 2 2 4-4"/></svg>
                    {% when 'wrench' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.65 2.65a1 1 0 0 1-1.4 0l-1.6-1.6a1 1 0 0 1 0-1.4Z"/></svg>
                    {% when 'smile' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                    {% when 'time' %}
                      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="24" cy="26" r="13" stroke="#fff" stroke-width="2"/>
                        <path d="M24 20V26L28 28" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                        <path d="M21 9H27" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                        <path d="M24 9V13" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                        <path d="M34 15L37 12" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    {% when 'shield' %}
                      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M24 8L37 13V22C37 30.5 31.5 37 24 40C16.5 37 11 30.5 11 22V13L24 8Z"
                              stroke="#fff" stroke-width="2" stroke-linejoin="round"/>
                        <path d="M18 24L22 28L30 19" 
                              stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% when 'hand' %}
                      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M7 21L13 15H20L24 18L28 15H35L41 21"
                                stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M13 15L18 20L21 23C22.2 24.2 24.2 24.2 25.4 23L29 19"
                                stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M18 20L14 24C12.8 25.2 12.8 27.2 14 28.4C15.2 29.6 17.2 29.6 18.4 28.4L21 26"
                                stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                          <path d="M29 19L35 25L31 29C29.8 30.2 27.8 30.2 26.6 29L24 26"
                                stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M35 25L38 28C39.2 29.2 39.2 31.2 38 32.4C36.8 33.6 34.8 33.6 33.6 32.4L31 29"
                                stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                      {% when 'card' %}
                        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <rect x="9" y="13" width="30" height="22" rx="3"
                                stroke="#fff" stroke-width="2"/>
                          <path d="M9 20H39"
                                stroke="#fff" stroke-width="2"/>
                          <path d="M15 28H22"
                                stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                          <path d="M29 28H34"
                                stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                  {% endcase %}
                </div>
                <span class="process-steps__number">{{ forloop.index }}</span>
              </div>

              <h3 class="process-steps__card-heading">{{ block.settings.heading }}</h3>
              {% if block.settings.text != blank %}
                <p class="process-steps__text">{{ block.settings.text }}</p>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TV mounting process",
  "class": "section-mounting",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our TV Mounting Process"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "clipboard-check", "label": "Clipboard check" },
            { "value": "wrench", "label": "Wrench" },
            { "value": "time", "label": "Time" },
            { "value": "shield", "label": "Shield" },
            { "value": "hand", "label": "Hand" },
            { "value": "card", "label": "Card" }
          ],
          "default": "clipboard"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Schedule Your Free Consultation"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Call or text (702) 600-3294 to discuss your Las Vegas project."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TV mounting process",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "clipboard",
            "heading": "Schedule Your Free Consultation",
            "text": "Call or text (702) 600-3294 to discuss your Las Vegas project. We'll ask about your TV size, wall type, and room layout to prepare the right hardware."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "clipboard-check",
            "heading": "Professional On-Site Assessment",
            "text": "Our installer arrives at your Las Vegas home, verifies stud locations, checks wall composition, and confirms the ideal TV placement with you."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "wrench",
            "heading": "Expert Installation",
            "text": "We mount your TV with precision leveling, secure anchoring, and complete wire concealment or outlet installation as needed."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "smile",
            "heading": "Final Walkthrough & Cleanup",
            "text": "We demonstrate everything, clean up completely, and review your 5-year warranty. Your Las Vegas home is left spotless - guaranteed."
          }
        }
      ]
    }
  ]
}
{% endschema %}