{% comment %}
  Branded 404 page: keeps lost visitors in the booking funnel.
{% endcomment %}

<div class="vtm-404">
  <div class="vtm-404__inner page-width">
    <div class="vtm-404__tv" aria-hidden="true">
      <div class="vtm-404__screen">
        <span class="vtm-404__code">404</span>
        <span class="vtm-404__static"></span>
      </div>
      <div class="vtm-404__mount"></div>
    </div>

    <h1 class="vtm-404__heading">{{ section.settings.heading }}</h1>
    <div class="vtm-404__text">{{ section.settings.text }}</div>

    <div class="vtm-404__actions">
      <a href="/pages/book" class="btn-primary"><span>Book Now</span></a>
      <a href="#" class="btn-secondary js-connect-popup"><span>Call or Text</span></a>
    </div>

    {%- assign popular = collections['residential'] -%}
    {%- if popular != blank and popular.products_count > 0 -%}
      <div class="vtm-404__popular">
        <p class="vtm-404__label">Popular services</p>
        <ul class="vtm-404__chips" role="list">
          {%- for product in popular.products limit: 6 -%}
            <li><a href="{{ product.url }}">{{ product.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <p class="vtm-404__home">
      Or head back to the <a href="{{ routes.root_url }}">homepage</a> ·
      <a href="/pages/service-areas">service areas</a> ·
      <a href="/pages/faq">FAQ</a>
    </p>
  </div>
</div>

<style>
  .vtm-404 {
    padding: 72px 16px 96px;
    text-align: center;
    background:
      radial-gradient(700px 320px at 50% 0%, rgba(224, 43, 43, 0.1), transparent 70%),
      #fff;
  }

  .vtm-404__inner {
    max-width: 720px;
  }

  .vtm-404__tv {
    width: min(320px, 80vw);
    margin: 0 auto 36px;
  }

  .vtm-404__screen {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    border: 10px solid #111;
    background: #0b0b0b;
    overflow: hidden;
    display: grid;
    place-items: center;
    box-shadow: 0 30px 50px -25px rgba(0, 0, 0, 0.6);
    transform: rotate(-4deg);
    animation: vtm-404-tilt 3.5s ease-in-out infinite;
  }

  .vtm-404__code {
    position: relative;
    z-index: 1;
    font-size: clamp(48px, 12vw, 76px);
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #fff;
    text-shadow: 3px 0 #e02b2b, -3px 0 #00c2ff;
  }

  .vtm-404__static {
    position: absolute;
    inset: -50%;
    background-image: repeating-radial-gradient(circle at 17% 32%, #fff 0 0.6px, transparent 1px 3px);
    opacity: 0.08;
    animation: vtm-404-static 0.4s steps(4) infinite;
  }

  .vtm-404__mount {
    width: 60px;
    height: 16px;
    margin: -2px auto 0;
    border-radius: 0 0 6px 6px;
    background: #2a2a2a;
  }

  @keyframes vtm-404-tilt {
    0%,
    100% {
      transform: rotate(-4deg);
    }
    50% {
      transform: rotate(-1.5deg);
    }
  }

  @keyframes vtm-404-static {
    to {
      transform: translate(3%, -2%);
    }
  }

  .vtm-404__heading {
    margin: 0 0 12px;
    font-weight: 700;
    line-height: 1.15;
  }

  .vtm-404__text {
    font-size: 17px;
    color: #444;
  }

  .vtm-404__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .vtm-404__actions .btn-primary,
  .vtm-404__actions .btn-secondary {
    min-height: 48px;
    padding: 10px 28px;
    justify-content: center;
  }

  .vtm-404__popular {
    margin-top: 44px;
  }

  .vtm-404__label {
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ac0000;
  }

  .vtm-404__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .vtm-404__chips a {
    display: inline-block;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    color: #111;
    font-size: 14px;
    text-decoration: none;
    transition: border-color 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }

  .vtm-404__chips a:hover {
    border-color: #ac0000;
    color: #ac0000;
    transform: translateY(-2px);
  }

  .vtm-404__home {
    margin-top: 32px;
    font-size: 14px;
    color: #666;
  }

  .vtm-404__home a {
    color: #ac0000;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .vtm-404__screen,
    .vtm-404__static {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "Branded 404",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This screen isn't mounted yet"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The page you're looking for has moved or doesn't exist. Let's get you back on track.</p>"
    }
  ],
  "presets": [
    {
      "name": "Branded 404"
    }
  ]
}
{% endschema %}
