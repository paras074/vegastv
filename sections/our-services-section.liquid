{% comment %}
  Section: Services Section
  - Heading / Subheading
  - Collection picker
  - Color scheme
  - Desktop + Mobile top/bottom padding
  - Card: 
      * Commercial tag  -> Only "Get a Free Quote" button
      * Quote tag       -> "Request a Quote" + "Call or Text"
      * default         -> "Book Now" + "Call or Text"
  - Your original card markup structure is kept as-is (no card CSS included, as requested)
{% endcomment %}

<div class="services-section color-{{ section.settings.color_scheme }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="page-width">
        {% if section.settings.heading != blank or section.settings.subheading != blank %}
          <div class="services-section__header">
            {% if section.settings.heading != blank %}
              <h2 class="services-section__heading">{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.subheading != blank %}
              <p class="services-section__subheading">{{ section.settings.subheading }}</p>
            {% endif %}
          </div>
        {% endif %}
      
        <ul class="services-section__grid" role="list">
          {% assign service_collection = collections[section.settings.collection] %}
          {% for product in service_collection.products %}
            <li class="services-section__card">
              <a href="{{ product.url }}" class="services-section__image-link">
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  srcset="{{ product.featured_image | image_url: width: 352 }} 352w, {{ product.featured_image | image_url: width: 600 }} 600w"
                  width="600"
                  height="400"
                  loading="lazy"
                  sizes="(min-width: 990px) 25vw, 50vw"
                  class="services-section__image"
                >
              </a>
              <div class="card-body-srvice">
                <h4 class="services-section__title">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h4>

                {% if product.tags contains 'commercial' %}
                  <a href="/pages/contact" class="book-service">
                    Get a Free Quote
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="18" viewBox="0 0 11 18" fill="none">
                      <path d="M3.01613 17.4808L10.4677 10.2115C11.1774 9.51923 11.1774 8.48077 10.4677 7.78846L3.01613 0.519231C2.30645 -0.173077 1.24194 -0.173077 0.532259 0.519231C-0.177419 1.21154 -0.177419 2.25 0.532259 2.94231L6.74194 9L0.532259 15.0577C0.17742 15.4038 2.67644e-07 15.75 2.67644e-07 16.2692C2.67644e-07 16.7885 0.17742 17.1346 0.532259 17.4808C1.24194 18.1731 2.30645 18.1731 3.01613 17.4808Z" fill="black"/>
                    </svg>
                  </a>
                {% else %}
                  {% if product.tags contains 'Quote' %}
                    <a href="/pages/contact" class="book-service">
                      Request a Quote
                      <svg xmlns="http://www.w3.org/2000/svg" width="11" height="18" viewBox="0 0 11 18" fill="none">
                        <path d="M3.01613 17.4808L10.4677 10.2115C11.1774 9.51923 11.1774 8.48077 10.4677 7.78846L3.01613 0.519231C2.30645 -0.173077 1.24194 -0.173077 0.532259 0.519231C-0.177419 1.21154 -0.177419 2.25 0.532259 2.94231L6.74194 9L0.532259 15.0577C0.17742 15.4038 2.67644e-07 15.75 2.67644e-07 16.2692C2.67644e-07 16.7885 0.17742 17.1346 0.532259 17.4808C1.24194 18.1731 2.30645 18.1731 3.01613 17.4808Z" fill="black"/>
                      </svg>
                    </a>
                  {% else %}
                    <a href="{{ product.url }}" class="book-service">
                      Book Now
                      <svg xmlns="http://www.w3.org/2000/svg" width="11" height="18" viewBox="0 0 11 18" fill="none">
                        <path d="M3.01613 17.4808L10.4677 10.2115C11.1774 9.51923 11.1774 8.48077 10.4677 7.78846L3.01613 0.519231C2.30645 -0.173077 1.24194 -0.173077 0.532259 0.519231C-0.177419 1.21154 -0.177419 2.25 0.532259 2.94231L6.74194 9L0.532259 15.0577C0.17742 15.4038 2.67644e-07 15.75 2.67644e-07 16.2692C2.67644e-07 16.7885 0.17742 17.1346 0.532259 17.4808C1.24194 18.1731 2.30645 18.1731 3.01613 17.4808Z" fill="black"/>
                      </svg>
                    </a>
                  {% endif %}

                  <a href="" class="book-service  js-connect-popup">
                    Call or Text <svg xmlns="http://www.w3.org/2000/svg" width="11" height="18" viewBox="0 0 11 18" fill="none">
                        <path d="M3.01613 17.4808L10.4677 10.2115C11.1774 9.51923 11.1774 8.48077 10.4677 7.78846L3.01613 0.519231C2.30645 -0.173077 1.24194 -0.173077 0.532259 0.519231C-0.177419 1.21154 -0.177419 2.25 0.532259 2.94231L6.74194 9L0.532259 15.0577C0.17742 15.4038 2.67644e-07 15.75 2.67644e-07 16.2692C2.67644e-07 16.7885 0.17742 17.1346 0.532259 17.4808C1.24194 18.1731 2.30645 18.1731 3.01613 17.4808Z" fill="black"/>
                      </svg>
                  </a>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
    </div>

</div>

{% style %}
  .services-section.color-{{ section.settings.color_scheme }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    .services-section.color-{{ section.settings.color_scheme }} {
      padding-top: {{ section.settings.padding_top_mobile }}px !important;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px !important;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "our Services Section",
  "tag": "section",
  "class": "section-services",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Services"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "our Services Section"
    }
  ]
}
{% endschema %}