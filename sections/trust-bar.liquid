{% stylesheet %}
  .trust-bar {
    width: 100%;
    background-color: #f7f7f7;
    border-top: 1px solid #dddddd;
    border-bottom: 1px solid #dddddd;
    box-sizing: border-box;
    overflow: hidden;
  }

  .trust-bar__inner {
    width: 100%;
    max-width: 1440px;
    min-height: 68px;
    margin: 0 auto;
    padding: 12px 32px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 24px;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .trust-bar__item {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    white-space: nowrap;
  }

  .trust-bar__icon {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #d5a52c;
  }

  .trust-bar__icon svg {
    width: 28px;
    height: 28px;
    display: block;
  }

  .trust-bar__label {
    color: #111111;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.25;
    white-space: nowrap;
  }

  .trust-bar__divider {
    width: 1px;
    height: 30px;
    flex: 0 0 1px;
    display: block;
    background-color: #d4d4d4;
  }

  @media screen and (max-width: 1199px) {
    .trust-bar__inner {
      max-width: none;
      min-height: 64px;
      padding: 10px 20px;
      justify-content: flex-start;
      gap: 20px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
    }

    .trust-bar__inner::-webkit-scrollbar {
      display: none;
    }

    .trust-bar__item {
      scroll-snap-align: start;
    }
  }

  @media screen and (max-width: 749px) {
    .trust-bar__inner {
      min-height: 60px;
      padding: 9px 16px;
      justify-content: flex-start;
      gap: 16px;
      overflow-x: auto;
      overflow-y: hidden;
    }

    .trust-bar__item {
      gap: 9px;
    }

    .trust-bar__icon {
      width: 27px;
      height: 27px;
      flex: 0 0 27px;
    }

    .trust-bar__icon svg {
      width: 25px;
      height: 25px;
    }

    .trust-bar__label {
      font-size: 13px;
      line-height: 1.2;
    }

    .trust-bar__divider {
      height: 27px;
    }
  }
{% endstylesheet %}

