<div
  class="service-areas color-{{ section.settings.color_scheme }}"
  style="
    --padding-top-desktop: {{ section.settings.padding_top }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="service-areas__wrapper page-width">
    {% if section.settings.heading != blank %}
      <h2 class="service-areas__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="service-areas__grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'column' %}
            <div class="service-areas__column" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="service-areas__column-heading">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.menu != blank %}
                <ul class="service-areas__list">
                  {% for link in linklists[block.settings.menu].links %}
                    <li>
                      <svg class="service-areas__pin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
                      <a href="{{ link.url }}"><span>{{ link.title }}</span></a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Service areas",
  "class": "section-areas",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Proudly Serving Las Vegas & Surrounding Areas"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "North & West"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Pick a navigation menu (Online Store > Navigation). Each menu item becomes a linked location with a pin icon."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service areas",
      "blocks": [
        { "type": "column", "settings": { "heading": "North & West" } },
        { "type": "column", "settings": { "heading": "South & East" } },
        { "type": "column", "settings": { "heading": "Surrounding" } },
        { "type": "column", "settings": { "heading": "And More" } }
      ]
    }
  ]
}
{% endschema %}