<div
  class="testimonials color-{{ section.settings.color_scheme }}"
  style="
    --padding-top-desktop: {{ section.settings.padding_top }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="testimonials__wrapper page-width">
    {% if section.settings.heading != blank %}
      <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="testimonials__slider-outer">
      <div
        class="testimonials__track {% if section.blocks.size > 3 %}is-slider{% else %}is-grid{% endif %}"
        id="testimonials-track-{{ section.id }}"
      >
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'testimonial' %}
              <div class="testimonials__card" {{ block.shopify_attributes }}>
                <svg class="testimonials__quote" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M9.5 8c-2.5 0-4.5 2-4.5 4.5S7 17 9.5 17c.3 0 .6 0 .9-.1-.6 1.6-2 2.9-3.9 3.3v2c3.6-.6 6-3.4 6-7.2V12c0-2.2-1.8-4-4-4zm10 0c-2.5 0-4.5 2-4.5 4.5S17 17 19.5 17c.3 0 .6 0 .9-.1-.6 1.6-2 2.9-3.9 3.3v2c3.6-.6 6-3.4 6-7.2V12c0-2.2-1.8-4-4-4z"/></svg>
                {% if block.settings.quote != blank %}
                  <p class="testimonials__quote-text">&quot;{{ block.settings.quote }}&quot;</p>
                {% endif %}
                <p class="testimonials__name">{{ block.settings.name }}</p>
                {% if block.settings.subtext != blank %}
                  <p class="testimonials__subtext">{{ block.settings.subtext }}</p>
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>

      {% if section.blocks.size > 3 %}
        <button type="button" class="testimonials__nav testimonials__nav--prev" aria-label="Previous" onclick="document.getElementById('testimonials-track-{{ section.id }}').scrollBy({left: -340, behavior: 'smooth'})">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" class="testimonials__nav testimonials__nav--next" aria-label="Next" onclick="document.getElementById('testimonials-track-{{ section.id }}').scrollBy({left: 340, behavior: 'smooth'})">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      {% endif %}
    </div>
  </div>
</div>

<style>
  

</style>

{% schema %}
{
  "name": "Testimonials",
  "class": "section-test",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Customers in Las Vegas Say"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Professional, quick, and the results are fantastic. Highly recommend clarity on fireplace mounting."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Sarah L."
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Patient Since 2021"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Professional, quick, and the results are fantastic. Highly recommend clarity on fireplace mounting.", "name": "Sarah L.", "subtext": "Patient Since 2021" } },
        { "type": "testimonial", "settings": { "quote": "Great experience from booking to complete setup. Super clean wire tuck work.", "name": "Brian K.", "subtext": "Verified Patient" } },
        { "type": "testimonial", "settings": { "quote": "They mounted my 75-inch TV over the fireplace perfectly. Zero wires showing!", "name": "Emily P.", "subtext": "Patient Since 2019" } }
      ]
    }
  ]
}
{% endschema %}