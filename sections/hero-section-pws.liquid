<style>
    .hero-section {
  position: relative;
  padding-top: var(--pt-mobile);
  padding-bottom: var(--pb-mobile);
  overflow: hidden;
}

    @media screen and (min-width: 990px) {
    .hero-section {
        padding-top: var(--pt-desktop);
        padding-bottom: var(--pb-desktop);
    }
    }

</style>
{%- liquid
  assign section_id = section.id
  assign img_pos = section.settings.image_position
-%}

<div
  class="hero-section color-{{ section.settings.color_scheme }}"
  style="
    --pt-desktop: {{ section.settings.padding_top }}px;
    --pb-desktop: {{ section.settings.padding_bottom }}px;
    --pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  {%- if section.settings.bg_image != blank -%}
    <div class="hero-section__bg ">
      {{
        section.settings.bg_image
        | image_url: width: 3000
        | image_tag: loading: 'lazy', sizes: '100vw', class: 'hero-section__bg-img'
      }}
    </div>
  {%- endif -%}

  <div class="hero-section__container page-width {% if section.settings.cutomclass !=blank %} {{ section.settings.cutomclass }} {% endif %}">
    <div class="hero-section__grid hero-section__grid--{{ img_pos }}">

      {%- if section.settings.image != blank -%}
        <div class="ggghgh hero-section__media">
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', class: 'hero-section__media-img'
          }}
        </div>
      {%- endif -%}

      <div class="hero-section__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="service-hero-section__eyebrow"><span>{{ section.settings.eyebrow }}</span></p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hero-section__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.paragraph != blank -%}
          <div class="hero-section__paragraph">{{ section.settings.paragraph }}</div>
        {%- endif -%}
        {%if section.settings.show_search !=blank %}
        <predictive-search-component
              class="predictive-search color-{{ settings.popover_color_scheme }}{% if class != blank %} {{ class | strip }}{% endif %}"
              style="--product-corner-radius: {{ settings.product_corner_radius | default: 8 | append: 'px' }}; --card-corner-radius: {{ settings.card_corner_radius | default: 8 | append: 'px' }};{% if settings.card_title_case == 'uppercase' %} --title-case: uppercase;{% endif %}"
              data-section-id="predictive-search"
              data-testid="{{ 'search-component--modal' }}"
              role="search"
              aria-label="{{ 'content.search_input_label' | t }}"
            >
              <form
                action="{{ routes.search_url }}"
                method="get"
                role="search"
                class="predictive-search-form"
                ref="form"
                on:keydown="/onSearchKeyDown"
              >
                <div
                  class="predictive-search-form__header"
                >
                  <div class="predictive-search-form__header-inner">
                    <label
                      for="{{ 'cmdk-input' | default: 'Search' }}"
                      class="visually-hidden"
                    >
                      {{- 'content.search_input_label' | t -}}
                    </label>
                    <input
                      class="search-input"
                      id="{{ 'cmdk-input' | default: 'Search' }}"
                      type="search"
                      name="q"
                      role="combobox"
                      aria-expanded="false"
                      aria-owns="predictive-search-results"
                      aria-controls="predictive-search-results"
                      aria-haspopup="listbox"
                      aria-autocomplete="list"
                      autocomplete="off"
                      placeholder="{{ 'content.search_input_placeholder' | t }}"
                      ref="searchInput"
                      on:input="/search"
                      on:keydown="/onSearchKeyDown"
                    >
                    <input
                      name="options[prefix]"
                      type="hidden"
                      value="last"
                    >
                    <span class="svg-wrapper predictive-search__icon">
                      {{ 'icon-search.svg' | inline_asset_content }}
                    </span>
                    <button
                      type="button"
                      class="button-unstyled predictive-search__reset-button"
                      ref="resetButton"
                      hidden
                      on:click="/resetSearch"
                    >
                      {{ 'actions.clear' | t }}
                    </button>
                  </div>
            
                </div>

                <div class="predictive-search-form__content-wrapper">
                  

                  <div class="predictive-search-form__footer">
                    <button
                      class="button predictive-search__search-button"
                      ref="viewAllButton"
                    >
                      {{ 'content.search_results_view_all' | t }}
                    </button>
                  </div>
                </div>
              </form>
        </predictive-search-component>
      {% endif %}
        {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
          <div class="hero-section__buttons">
            {%- if section.settings.button_1_label != blank -%}
              <a
                {% if section.settings.button_1_link != blank %}
                  href="{{ section.settings.button_1_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="btn-primary">
                
                <span>{{ section.settings.button_1_label }}</span>
              </a>
            {%- endif -%}

            {%- if section.settings.button_2_label != blank -%}
              <a
                {% if section.settings.button_2_link != blank %}
                  href="{{ section.settings.button_2_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="btn-secondary js-connect-popup"
              >
            
                <span>{{ section.settings.button_2_label }}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="hero-section__trust-list" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'trust_icon' -%}
                <li class="hero-section__trust-item" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon_type == 'svg' -%}
                    {%- if block.settings.svg_code != blank -%}
                      <span class="hero-section__trust-icon">
                        {{ block.settings.svg_code }}
                      </span>
                    {%- endif -%}
                  {%- else -%}
                    {%- if block.settings.icon != blank -%}
                      {{
                        block.settings.icon
                        | image_url: width: 80
                        | image_tag: loading: 'lazy', class: 'hero-section__trust-icon'
                      }}
                    {%- endif -%}
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <span class="hero-section__trust-text">{{ block.settings.text }}</span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero section-new",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search",
      "default": false
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "text",
      "id":"cutomclass",
      "label": "Custom Class"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Background media"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Content image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Text content"
    },
     {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Add a hero heading"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "<p>Add a short supporting paragraph for your hero section.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 40
    }
  ],
  "blocks": [
    {
  "type": "trust_icon",
  "name": "Trust icon",
  "settings": [
    {
      "type": "select",
      "id": "icon_type",
      "label": "Icon type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "svg",
          "label": "SVG Code"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon Image"
    },
    {
      "type": "html",
      "id": "svg_code",
      "label": "SVG Code",
      "info": "Paste raw SVG code here."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free shipping"
    }
  ]
}
  ],
  "presets": [
    {
      "name": "Hero section",
      "blocks": [
        { "type": "trust_icon" },
        { "type": "trust_icon" },
        { "type": "trust_icon" }
      ]
    }
  ]
}
{% endschema %}