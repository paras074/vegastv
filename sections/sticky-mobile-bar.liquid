{% comment %}
  Sticky Mobile Action Bar
  - Fixed to bottom, visible only on mobile
  - 3 buttons: Call, Text, Quote (each with icon + label + link)
{% endcomment %}

<style>
 

  @media screen and (max-width: 749px) {
    .sticky-mobile-bar {
      display: block;
    }
    body {
      padding-bottom: calc({{ section.settings.padding_top }}px + {{ section.settings.padding_bottom }}px + 52px);
    }
  }
</style>

<div class="sticky-mobile-bar">
    <p class="text-privacy">Texts from Vegas TV Mounting (702) 720-1109. 1–4 msgs/appt. Rates apply. STOP to opt out.<a href="/policies/privacy-policy">Privacy</a> <a href="/policies/terms-of-service">Terms</a></p>
  <div class="sticky-mobile-bar__inner">
    {% for block in section.blocks %}
      {% assign is_last = forloop.last %}

      {% case block.settings.icon %}
        {% when 'call' %}
          <a href="tel:{{ block.settings.phone }}" class="sticky-mobile-bar__btn" {{ block.shopify_attributes }}>
            <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.32 1.78.6 2.63a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.45-1.17a2 2 0 0 1 2.11-.45c.85.28 1.73.48 2.63.6A2 2 0 0 1 22 16.92z"/></svg>
            <span>{{ block.settings.label | default: 'Call' }}</span>
          </a>

        {% when 'text' %}
          <a href="sms:{{ block.settings.phone }}" class="sticky-mobile-bar__btn" {{ block.shopify_attributes }}>
            <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span>{{ block.settings.label | default: 'Text' }}</span>
          </a>

        {% when 'quote' %}
          <a href="{{ block.settings.link }}" class="sticky-mobile-bar__btn" {{ block.shopify_attributes }}>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M17.5 2H14.5V0.5C14.5 0.367392 14.4473 0.240215 14.3536 0.146447C14.2598 0.0526785 14.1326 0 14 0C13.8674 0 13.7402 0.0526785 13.6464 0.146447C13.5527 0.240215 13.5 0.367392 13.5 0.5V2H6.5V0.5C6.5 0.367392 6.44732 0.240215 6.35355 0.146447C6.25979 0.0526785 6.13261 0 6 0C5.86739 0 5.74021 0.0526785 5.64645 0.146447C5.55268 0.240215 5.5 0.367392 5.5 0.5V2H2.5C1.8372 2.00079 1.20178 2.26444 0.73311 2.73311C0.264441 3.20178 0.000793929 3.8372 0 4.5V17.5C0.000793929 18.1628 0.264441 18.7982 0.73311 19.2669C1.20178 19.7356 1.8372 19.9992 2.5 20H17.5C18.163 20 18.7989 19.7366 19.2678 19.2678C19.7366 18.7989 20 18.163 20 17.5V4.5C20 3.83696 19.7366 3.20107 19.2678 2.73223C18.7989 2.26339 18.163 2 17.5 2ZM19 17.5C19 17.8978 18.842 18.2794 18.5607 18.5607C18.2794 18.842 17.8978 19 17.5 19H2.5C2.10218 19 1.72064 18.842 1.43934 18.5607C1.15804 18.2794 1 17.8978 1 17.5V9H19V17.5ZM19 8H1V4.5C1 3.672 1.67 3 2.5 3H5.5V4.5C5.5 4.63261 5.55268 4.75979 5.64645 4.85355C5.74021 4.94732 5.86739 5 6 5C6.13261 5 6.25979 4.94732 6.35355 4.85355C6.44732 4.75979 6.5 4.63261 6.5 4.5V3H13.5V4.5C13.5 4.63261 13.5527 4.75979 13.6464 4.85355C13.7402 4.94732 13.8674 5 14 5C14.1326 5 14.2598 4.94732 14.3536 4.85355C14.4473 4.75979 14.5 4.63261 14.5 4.5V3H17.5C17.8978 3 18.2794 3.15804 18.5607 3.43934C18.842 3.72064 19 4.10218 19 4.5V8Z" fill="white"/>
            </svg>
            <span>{{ block.settings.label | default: 'Get a Quote' }}</span>
          </a>
      {% endcase %}

      {% unless is_last %}
        <div class="sticky-mobile-bar__divider"></div>
      {% endunless %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Sticky Mobile Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Button type / icon",
          "options": [
            { "value": "call", "label": "Call" },
            { "value": "text", "label": "Text" },
            { "value": "quote", "label": "Quote (link)" }
          ],
          "default": "call"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Button label"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone number",
          "info": "Used for Call and Text buttons, e.g. +11234567890"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Used for Quote button"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Sticky Mobile Bar",
      "blocks": [
        { "type": "button", "settings": { "icon": "call", "label": "Call" } },
        { "type": "button", "settings": { "icon": "text", "label": "Text" } },
        { "type": "button", "settings": { "icon": "quote", "label": "Get a Quote" } }
      ]
    }
  ]
}
{% endschema %}