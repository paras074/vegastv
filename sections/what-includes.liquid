{%- style -%}
  #section-whats-included-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #section-whats-included-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}
<section id="section-whats-included-{{ section.id }}" class="color-{{ section.settings.color_scheme }} section-whats-included">
  <div class=" wi-section">
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="wi-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="wi-grid">
        {%- for block in section.blocks -%}
          <div class="wi-card" {{ block.shopify_attributes }}>
            <div class="wi-icon">
              {%- case block.settings.icon -%}
                {%- when 'tv' -%}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="6" y="9" width="36" height="24" rx="2" stroke="currentColor" stroke-width="2.2"/>
                    <path d="M17 41h14M24 33v8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                  </svg>
                {%- when 'surround' -%}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="17" y="4" width="14" height="40" rx="3" stroke="currentColor" stroke-width="2.2"/>
                    <circle cx="24" cy="13" r="3" stroke="currentColor" stroke-width="2"/>
                    <circle cx="24" cy="24" r="3" stroke="currentColor" stroke-width="2"/>
                    <circle cx="24" cy="35" r="3" stroke="currentColor" stroke-width="2"/>
                  </svg>
                {%- when 'receiver' -%}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="5" y="15" width="38" height="18" rx="2" stroke="currentColor" stroke-width="2.2"/>
                    <circle cx="14" cy="24" r="3.4" stroke="currentColor" stroke-width="2"/>
                    <circle cx="24" cy="24" r="3.4" stroke="currentColor" stroke-width="2"/>
                    <path d="M32 21h6M32 27h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                {%- when 'gamepad' -%}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M14 16h20a9 9 0 0 1 9 9v3a6 6 0 0 1-11.2 3l-1.4-2a3 3 0 0 0-2.5-1.3h-3.8a3 3 0 0 0-2.5 1.3l-1.4 2A6 6 0 0 1 9 28v-3a9 9 0 0 1 9-9z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
                    <path d="M16 21v6M13 24h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <circle cx="33" cy="21" r="1.6" fill="currentColor"/>
                    <circle cx="37" cy="25" r="1.6" fill="currentColor"/>
                  </svg>
                {%- when 'bulb' -%}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M24 5a13 13 0 0 0-7 24c1.6 1 2 2.5 2 4v1h10v-1c0-1.5.4-3 2-4a13 13 0 0 0-7-24z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
                    <path d="M20 40h8M21.5 43.5h5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                  </svg>
                {%- when 'cable' -%}
                  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M32 9c-9 0-4 12-13 12S6 33 15 33s-4 12 5 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                  </svg>
                {%- else -%}
                  {%- if block.settings.custom_icon != blank -%}
                    <img src="{{ block.settings.custom_icon | image_url: width: 96 }}" alt="" width="34" height="34" loading="lazy">
                  {%- endif -%}
              {%- endcase -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="wi-card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="wi-card-text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>
</section>


{% schema %}
{
  "name": "What's Included",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's Included"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "tv", "label": "TV / Projector" },
            { "value": "surround", "label": "Surround sound" },
            { "value": "receiver", "label": "AV receiver" },
            { "value": "gamepad", "label": "Gamepad" },
            { "value": "bulb", "label": "Lighting" },
            { "value": "cable", "label": "Cable / wire" },
            { "value": "custom", "label": "Custom image" }
          ],
          "default": "tv"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon image",
          "info": "Used when icon is set to Custom image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "TV or Projector Installation"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Secure mounting for the perfect view.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "What's Included",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "tv",
            "title": "TV or Projector Installation",
            "text": "<p>Secure mounting for the perfect view.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "surround",
            "title": "Surround Sound Setup",
            "text": "<p>Immersive audio with in-wall or in-ceiling speakers.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "receiver",
            "title": "AV Receiver & Equipment Setup",
            "text": "<p>We configure and connect all your devices.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "gamepad",
            "title": "Gaming & Streaming Optimization",
            "text": "<p>Low-latency setup for gaming and flawless streaming.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "bulb",
            "title": "Lighting Control Integration",
            "text": "<p>Smart lighting and dimmers for the perfect ambiance.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "cable",
            "title": "Wire Concealment",
            "text": "<p>All wires are hidden for a clean, finished look.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}