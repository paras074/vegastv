<section class="service-areas">
  <div class="page-width">

    <div class="service-areas__header">
      {% if section.settings.eyebrow != blank %}
        <span class="service-areas__eyebrow">
          {{ section.settings.eyebrow }}
        </span>
      {% endif %}

      <h2>{{ section.settings.heading }}</h2>

      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="service-areas__grid">
      {% for block in section.blocks %}
        <a
          href="{{ block.settings.location_url }}"
          class="service-areas__card"
          aria-label="View services in {{ block.settings.location_name }}"
          {{ block.shopify_attributes }}
        >
          <div class="service-areas__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/>
              <circle cx="12" cy="10" r="2.5"/>
            </svg>
          </div>

          <div class="service-areas__content">
            <h3>{{ block.settings.location_name }}</h3>

            {% if block.settings.location_description != blank %}
              <p>{{ block.settings.location_description }}</p>
            {% endif %}
          </div>

          <div class="service-areas__arrow" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14"/>
              <path d="m13 6 6 6-6 6"/>
            </svg>
          </div>
        </a>
      {% endfor %}
    </div>

  </div>
</section>

{% stylesheet %}
  .service-areas {
    width: 100%;
    padding: 80px 24px;
    background: #f7f7f7;
    box-sizing: border-box;
  }


  .service-areas__header {
    max-width: 760px;
    margin: 0 auto 42px;
    text-align: center;
  }

  .service-areas__eyebrow {
    display: inline-block;
    margin-bottom: 12px;
    color: #b98512;
    font-size: 13px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .service-areas__header h2 {
    margin: 0 0 12px;
    color: #111111;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .service-areas__header p {
    margin: 0;
    color: #555555;
    font-size: 17px;
    line-height: 1.6;
  }

  .service-areas__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .service-areas__card {
    position: relative;
    min-height: 112px;
    padding: 24px 52px 24px 22px;
    display: flex;
    align-items: center;
    gap: 16px;
    color: inherit;
    text-decoration: none;
    background: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.045);
    box-sizing: border-box;
    overflow: hidden;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .service-areas__card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 20px;
    right: 20px;
    height: 3px;
    background: linear-gradient(
      90deg,
      #b98512,
      #e2b83f,
      #b98512
    );
    border-radius: 0 0 4px 4px;
  }

  .service-areas__card:hover {
    transform: translateY(-4px);
    border-color: #d5a52c;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.09);
  }

  .service-areas__icon {
    width: 46px;
    height: 46px;
    flex: 0 0 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d5a52c;
    background: #fffaf0;
    border: 1px solid #f0dfb0;
    border-radius: 50%;
  }

  .service-areas__icon svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  .service-areas__content {
    min-width: 0;
  }

  .service-areas__content h3 {
    margin: 0 0 4px;
    color: #171717;
    font-size: 18px;
    line-height: 1.25;
    font-weight: 750;
  }

  .service-areas__content p {
    margin: 0;
    color: #666666;
    font-size: 14px;
    line-height: 1.45;
  }

  .service-areas__arrow {
    position: absolute;
    top: 50%;
    right: 20px;
    width: 20px;
    height: 20px;
    color: #8a8a8a;
    transform: translateY(-50%);
    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  .service-areas__arrow svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .service-areas__card:hover .service-areas__arrow {
    color: #b98512;
    transform: translate(3px, -50%);
  }

  @media screen and (max-width: 989px) {
    .service-areas {
      padding: 64px 20px;
    }

    .service-areas__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .service-areas {
      padding: 52px 16px;
    }

    .service-areas__header {
      margin-bottom: 30px;
    }

    .service-areas__header h2 {
      font-size: 32px;
    }

    .service-areas__header p {
      font-size: 15px;
    }

    .service-areas__grid {
      grid-template-columns: 1fr;
      gap: 13px;
    }

    .service-areas__card {
      min-height: 96px;
      padding: 20px 48px 20px 18px;
    }

    .service-areas__icon {
      width: 42px;
      height: 42px;
      flex-basis: 42px;
    }

    .service-areas__content h3 {
      font-size: 17px;
    }
  }
{% endstylesheet %}

